    LABELS = [("open_mode", "open mode"), ("claude_model", "claude model"), ("claude_effort", "claude effort"),
              ("menu_width", "menu width"), ("recent_days", "recent (days)"), ("on_problem", "on problem")]

    def __init__(self):
        super().__init__()
        self.sel = 0

    def compose(self) -> ComposeResult:
        with Vertical():
            yield Static("Settings", id="stitle")
            for key, label in self.LABELS:
                with Horizontal(classes="srow", id=f"row-{key}"):
                    yield Static("", id=f"v-{key}", markup=False)
                    yield Button("−", id=f"m-{key}")
