class Menu(App):
    TITLE = "hyperbeam"
    ENABLE_COMMAND_PALETTE = False
    CSS = """
    #title { height: 1; padding: 0 1; text-style: bold; color: $accent; }
    Tabs { height: 2; }
    #list { height: 1fr; border: round $primary; }
    #detail { height: 3; padding: 0 1; color: $text-muted; }
    #notice { height: 3; padding: 0 1; }
    #buttons { height: 1; margin-top: 1; }
    #buttons Button { height: 1 !important; border: none !important; margin-right: 2; min-width: 12; }
    #keys { width: auto; height: 1; padding: 0 1; color: $text-muted; }
    #hint { height: 1; padding: 0 1; color: $text-muted; }
    """
    BINDINGS = [Binding("o", "open", "Open"), Binding("s", "stop", "Stop"), Binding("b", "onboard", "Onboard"), Binding("i", "info", "Info"), Binding("m", "mode", "Mode"),
                Binding("r", "refresh", "Refresh"), Binding("q", "quit", "Quit"),
                Binding("left", "tab(-1)", "prev tab", show=False), Binding("right", "tab(1)", "next tab", show=False)]

    def __init__(self):
        super().__init__()
        self.projects, self.tab, self.busy = [], "running", set()
        self.first_done = False
        self.keep_notice = False        # True after an action: the refresh then leaves its result message on screen

    def compose(self) -> ComposeResult:
        yield Static("hyperbeam", id="title")
        yield Tabs(*[Tab(label, id=f"t-{key}") for key, label in TABS], id="tabs")
        yield OptionList(id="list")
        yield Static("", id="detail", markup=False)
        yield Static("Loading projects...", id="notice", markup=False)
        with Horizontal(id="buttons"):
            for bid, label in [("open", "Open (o)"), ("stop", "Stop (s)"), ("onboard", "Onboard (b)"),
                               ("info", "Info (i)"), ("mode", f"Mode: {open_mode()} (m)"), ("refresh", "Refresh (r)"), ("quit", "Quit (q)")]:
                button = Button(label, id=f"b-{bid}")
                button.can_focus = False
                yield button
            yield Static(HINT, id="keys", markup=False)
        yield Static("up/down: select   left/right: tab   Enter or click a row: open   Quit detaches (the menu keeps running)", id="hint")

    def on_mount(self):
        self.query_one("#list", OptionList).focus()
        self.action_refresh()
        self.set_interval(3, self.poll_running)

    # --- data ---
    def action_refresh(self):
        self.reload(keep=False)

    def reload(self, keep):
        self.keep_notice = keep
        if not keep:
            self.say("Scanning projects...")
        self.run_worker(self._load, thread=True, exclusive=True, group="load")

    def _load(self):
        rows = build_projects()
        self.call_from_thread(self.apply, rows)

    def apply(self, rows):
        self.projects = rows
        if not self.first_done:
            self.first_done = True
            for key in ("running", "recent", "mine"):
                self.tab = key
                if self.visible():
                    break
            self.query_one("#tabs", Tabs).active = f"t-{self.tab}"
        self.render_list()
        if not self.keep_notice:
            self.say(f"{len(rows)} projects, {sum(1 for r in rows if r['running'])} running")

    def poll_running(self):
        run_set = running_sessions()
        changed = False
        for p in self.projects:
            now = sanitize(p["name"]) in run_set
            changed |= now != p["running"]
            p["running"] = now
        if changed:
            self.render_list()

    def visible(self):
        P, t = self.projects, self.tab
        if t == "running":
            return [p for p in P if p["running"]]
        if t == "recent":
            return sorted([p for p in P if p["opened"]], key=lambda p: -p["opened"])
        if t == "mine":
            return [p for p in P if p["owner"] == "mine"]
        if t == "others":
            return [p for p in P if p["owner"] != "mine"]
        if t == "settings":
            return []
        return [p for p in P if not p["manifest"]]

    def render_settings(self):
        ol = self.query_one("#list", OptionList)
        ol.clear_options()
        ol.add_option(Option(Text(f"  open mode: {open_mode()}   (Enter or Mode (m) toggles it)", style="bold"), id="open_mode"))
        mode_help = {"switch": "Open switches this terminal to the project (also over SSH).",
                     "window": "Open starts a new kitty window per project at the laptop (over SSH it switches)."}
        ol.add_option(Option(Text("      " + mode_help[open_mode()], style="dim"), disabled=True))
        for title, keys in (("hyperbeam keys (no prefix)", KEYS), ("your tmux keys (prefix is C-a)", USER_KEYS)):
            ol.add_option(Option(Text(f"\n  {title}", style="bold cyan"), disabled=True))
            for k, d in keys:
                ol.add_option(Option(Text(f"    {k:<22}{d}"), disabled=True))
        ol.add_option(Option(Text("\n  Mouse: click a pane to select it; drag to select text and copy it (Shift+drag: kitty's selection).", style="dim"), disabled=True))
        ol.highlighted = 0

    def toggle_mode(self):
        set_open_mode("window" if open_mode() == "switch" else "switch")
        self.query_one("#b-mode", Button).label = f"Mode: {open_mode()} (m)"
        if self.tab == "settings":
            self.render_settings()
        self.say(f"open mode: {open_mode()} (saved in config.toml)")

    def action_mode(self):
        self.toggle_mode()

    def render_list(self):
        ol = self.query_one("#list", OptionList)
        if self.tab == "settings":
            self.render_settings()
            self.show_detail()
            return
        keep = self.current()
        ol.clear_options()
        rows = self.visible()
        for p in rows:
            t = Text()
            t.append("● " if p["running"] else "  ", style="green")
            t.append(f"{p['name']:<26}")
            t.append(f"{p['owner']:<10}", style="dim")
            t.append(f"{p['port'] or '-':>5} ", style="cyan" if p["manifest"] else "dim")
            t.append("* " if p["dirty"] else "  ", style="yellow")
            t.append("configured" if p["manifest"] else "not configured", style="dim")
            if self.tab == "recent":
                t.append(f"  {ago(p['opened'])}", style="dim")
            ol.add_option(Option(t, id=p["name"]))
        if rows:
            names = [p["name"] for p in rows]
            ol.highlighted = names.index(keep["name"]) if keep and keep["name"] in names else 0
            self.call_after_refresh(ol.scroll_to_highlight)
        else:
            ol.add_option(Option(Text("  (nothing here)", style="dim italic"), disabled=True))
        counts = {"running": sum(p["running"] for p in self.projects), "recent": sum(1 for p in self.projects if p["opened"]),
                  "mine": sum(p["owner"] == "mine" for p in self.projects),
                  "others": sum(p["owner"] != "mine" for p in self.projects),
                  "unconfigured": sum(not p["manifest"] for p in self.projects)}
        for key, label in TABS:
            self.query_one(f"#t-{key}", Tab).label = f"{label} ({counts[key]})" if key in counts else label
        self.show_detail()

    def current(self):
        ol = self.query_one("#list", OptionList)
        if ol.highlighted is None or ol.highlighted >= ol.option_count:
            return None
        name = ol.get_option_at_index(ol.highlighted).id
        return next((p for p in self.projects if p["name"] == name), None)

    def show_detail(self):
        p = self.current()
        if not p:
            self.query_one("#detail", Static).update("")
            return
        man = load_manifests().get(p["name"])
        svcs = ", ".join(s["name"] for s in man.get("service", [])) if man else ""
        warn = [w for w, bad in [("no git", not p["git"]), ("no remote", p["git"] and not p["remote"]),
                                 ("uncommitted", p["dirty"]), ("no CLAUDE.md", not (p["path"] / "CLAUDE.md").exists())] if bad]
        self.query_one("#detail", Static).update(
            f"{home_rel(p['path'])}   {p['remote'] or ''}\n"
            f"services: {svcs or '-'}   port: {p['port'] or 'none'}   url: {project_url(p['port']) or '-'}\nwarnings: {', '.join(warn) or 'none'}")

    def say(self, msg):
        self.query_one("#notice", Static).update(msg)

    def say_from_thread(self, msg):
        self.call_from_thread(self.say, msg)

    # --- events ---
    def on_tabs_tab_activated(self, event):
        if event.tab is not None:
            self.tab = event.tab.id[2:]
            self.render_list()

    def on_option_list_option_highlighted(self, event):
        self.show_detail()

    def on_option_list_option_selected(self, event):
        if self.tab == "settings":
            return self.toggle_mode() if event.option.id == "open_mode" else None
        self.action_open()

    def on_button_pressed(self, event):
        if event.button.id and event.button.id.startswith("b-"):
            getattr(self, "action_" + event.button.id[2:])()

    def action_tab(self, step: int):
        tabs = self.query_one("#tabs", Tabs)
        tabs.action_next_tab() if step > 0 else tabs.action_previous_tab()

    # --- actions ---
    def action_open(self):
        p = self.current()
        if not p:
            return self.say("Nothing selected.")
        if p["name"] in self.busy:
            return self.say(f"{p['name']} is busy.")
        self.busy.add(p["name"])
        self.run_worker(lambda: self._open(p), thread=True)

    def _open(self, p, onboard=False):
        """Open: start the session if needed (no manifest or a failing start lands in Claude with the investigate prompt),
        then switch this client to it. Onboard forces the investigate prompt."""
        name, sess = p["name"], sanitize(p["name"])
        try:
            man = load_manifests().get(name)
            if not session_exists(sess):
                start_session(name, man, self.say_from_thread, path=p["path"], reason="Onboard requested" if onboard else None)
            elif onboard:
                investigate_window(name, p["path"], "Onboard requested; the session was already running")
            touch_opened(name)
            how = show_session(sess)
            self.say_from_thread(f"{name}: {how} ({HINT})")
        except Exception as e:
            self.say_from_thread(f"{name}: ERROR {e}")
        finally:
            self.busy.discard(name)
            self.call_from_thread(self.reload, True)

    def action_stop(self):
        p = self.current()
        if not p:
            return self.say("Nothing selected.")
        man = load_manifests().get(p["name"])
        if not man and not p["running"]:
            return self.say(f"{p['name']} is not running.")
        ports = ", ".join(map(str, project_ports(man))) or "(none: no manifest)"

        def after(yes):
            if yes and p["name"] not in self.busy:
                self.busy.add(p["name"])
                self.run_worker(lambda: self._stop(p), thread=True)
        self.push_screen(Confirm(f"Stop {p['name']}?\n\nRuns its stop commands in reverse order, kills the tmux session, "
                                 f"and checks that port(s) {ports} are free."), after)

    def _stop(self, p):
        try:
            stop_project(p["name"], load_manifests().get(p["name"]), self.say_from_thread)
        except Exception as e:
            self.say_from_thread(f"{p['name']}: ERROR {e}")
        finally:
            self.busy.discard(p["name"])
            self.call_from_thread(self.reload, True)

    def action_onboard(self):
        p = self.current()
        if not p:
            return self.say("Nothing selected.")
        if p["name"] in self.busy:
            return self.say(f"{p['name']} is busy.")
        self.busy.add(p["name"])
        self.run_worker(lambda: self._open(p, onboard=True), thread=True)

    def action_info(self):
        """The same text as `kk`, in a plain tmux window (so mouse-drag copy works), closed with Enter."""
        p = self.current()
        if not p:
            return self.say("Nothing selected.")
        win = f"info-{sanitize(p['name'])}"
        tmux("kill-window", "-t", f"={MENU}:={win}", check=False)
        tmux("new-window", "-t", f"{MENU}:", "-n", win,
             f"{SELF} info {shlex.quote(p['name'])}; echo; read -r -p '[Enter closes this window] '")

    def action_quit(self):
        """Quit detaches the client; the menu keeps running in its tmux session."""
        c = menu_client()
        if c:
            tmux("detach-client", "-t", c, check=False)


def run_menu():
    Menu().run()


def main():
    ap = argparse.ArgumentParser(prog="hyperbeam", description=__doc__)
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("scan", help="list projects").set_defaults(f=cmd_scan)
    o = sub.add_parser("open", help="start a project's session and attach in this terminal")
    o.add_argument("name")
    o.add_argument("-d", "--detach", action="store_true", help="start the session but do not attach")
    o.set_defaults(f=cmd_open)
    s = sub.add_parser("stop", help="run stop commands, kill the session, check the ports")
    s.add_argument("name")
    s.set_defaults(f=cmd_stop)
    sub.add_parser("list", help="numbered list of running sessions with URLs; a number switches to it").set_defaults(f=cmd_list)
    sub.add_parser("phone", help="print the URLs, then attach to the most recently used session").set_defaults(f=cmd_phone)
    i = sub.add_parser("info", help="URLs and endpoints of a project (alias: kk)")
    i.add_argument("project", nargs="?")
    i.set_defaults(f=cmd_info)
    sub.add_parser("_menu").set_defaults(f=lambda _: run_menu())
    st = sub.add_parser("_stack")
    st.add_argument("direction", choices=["next", "prev"])
    st.add_argument("client")
    st.add_argument("session")
    st.set_defaults(f=cmd_stack)
    cp = sub.add_parser("_copy-pane")
    cp.add_argument("client_pid")
    cp.add_argument("client")
    cp.add_argument("pane")
    cp.add_argument("session")
    cp.set_defaults(f=cmd_copy_pane)
    cl = sub.add_parser("_clip")
    cl.add_argument("client_pid")
    cl.set_defaults(f=cmd_clip)
    w = sub.add_parser("_warn")
    w.add_argument("path")
    w.set_defaults(f=cmd_warn)
    argv = sys.argv[1:]
    if Path(sys.argv[0]).name == "kk":      # ~/.local/bin/kk is a symlink to this script
        argv = ["info", *argv]
    a = ap.parse_args(argv)
    if a.cmd is None:
        cmd_menu(a)
    else:
        sys.exit(a.f(a) or 0)


if __name__ == "__main__":
    main()
