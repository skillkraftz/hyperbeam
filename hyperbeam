def source_conf():
    """Load hyperbeam.conf into the running tmux server (tmux.conf also sources it at server start)."""
    tmux("source-file", "-q", str(HERE / "hyperbeam.conf"), check=False)


def stack():
    """The session stack: the menu, then hyperbeam's project sessions in the order they were created."""
    fmt = "#{session_created}\t#{session_name}\t#{@hb}"
    rows = sorted(l.split("\t") for l in tmux("list-sessions", "-F", fmt, check=False).stdout.splitlines())
    names = [r[1] for r in rows if len(r) == 3 and r[2] == "1" and r[1] != MENU]
    return ([MENU] if session_exists(MENU) else []) + names


def client_is_remote(pid):
    """Is the tmux client with this pid on an SSH/mosh connection? Looks at its environment and its ancestors."""
    try:
        env = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        if any(e.startswith((b"SSH_CONNECTION=", b"SSH_TTY=")) for e in env):
            return True
    except OSError:
        pass
    p = int(pid)
    for _ in range(40):
        try:
            stat = Path(f"/proc/{p}/stat").read_text()
        except OSError:
            break
        comm = stat[stat.index("(") + 1:stat.rindex(")")]
        if comm.startswith(("sshd", "mosh-server", "tailscaled")):
            return True
        p = int(stat[stat.rindex(")") + 2:].split()[1])
        if p <= 1:
            break
    return False


def wl_copy(text):
    """Put text on the Wayland clipboard. A tmux server that was started over SSH has no WAYLAND_DISPLAY: use the socket."""
    env = dict(os.environ)
    rt = env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    if not env.get("WAYLAND_DISPLAY"):
        socks = sorted(Path(rt).glob("wayland-[0-9]*"))
        socks = [x for x in socks if not x.name.endswith(".lock")]
        if not socks:
            raise RuntimeError("no Wayland display")
        env["WAYLAND_DISPLAY"] = socks[0].name
    subprocess.run(["wl-copy"], input=text.encode(), env=env, stdin=None, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, timeout=5, check=True)


def tmux_msg(client, msg):
    tmux("display-message", "-c", client, msg, check=False)


def cmd_stack(a):
    names = stack()
    if len(names) < 2:
        return tmux_msg(a.client, "stack: only one session")
    step = 1 if a.direction == "next" else -1
    i = (names.index(a.session) + step) % len(names) if a.session in names else (0 if step > 0 else -1)
    tmux("switch-client", "-c", a.client, "-t", home_target(a.client) if names[i] == MENU else f"={names[i]}")
    tmux_msg(a.client, f"stack {names.index(names[i]) + 1}/{len(names)}: {names[i]}")


CLAUDE_DIR = Path(os.environ.get("HB_CLAUDE_DIR") or Path.home() / ".claude")      # HB_CLAUDE_DIR: tests


def claude_session_file(pane):
    """The conversation file (~/.claude/projects/<cwd>/<session id>.jsonl) of the Claude running in tmux pane `pane`, or None if the pane is not
    running claude. Claude Code writes ~/.claude/sessions/<pid>.json (pid, sessionId, cwd, and `tmux: <session>:<window>.<pane id>`) for every
    interactive session: that names the exact session. Fallback: the newest .jsonl of the pane's cwd."""
    cmd, cwd = (tmux("display-message", "-p", "-t", pane, "#{pane_current_command}\t#{pane_current_path}", check=False).stdout.strip("\n").split("\t") + ["", ""])[:2]
    if cmd != "claude":
        return None
    best = None
    for f in (CLAUDE_DIR / "sessions").glob("*.json"):
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if str(d.get("tmux", "")).endswith(f".{pane}") and Path(f"/proc/{d.get('pid')}").exists() and (best is None or int(d.get("startedAt", 0)) > int(best.get("startedAt", 0))):
            best = d
    if best and best.get("sessionId"):
        proj = CLAUDE_DIR / "projects" / re.sub(r"[^A-Za-z0-9]", "-", best.get("cwd") or cwd)
        if (proj / f"{best['sessionId']}.jsonl").is_file():
            return proj / f"{best['sessionId']}.jsonl"
    files = sorted((CLAUDE_DIR / "projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd)).glob("*.jsonl"), key=lambda x: x.stat().st_mtime)
    return files[-1] if files else None


def tool_summary(b):
    """One line for a tool call: the tool and its main argument."""
    i = b.get("input") or {}
    arg = next((str(i[k]) for k in ("command", "file_path", "path", "pattern", "url", "query", "description", "prompt", "skill") if i.get(k)), "")
    return f"  [{b.get('name', 'tool')}] " + clip(" ".join(arg.split()), 110)


def transcript_text(f):
    """A Claude Code conversation file as plain text: your messages and Claude's replies; tool calls as one-line summaries; no thinking, no tool
    output, no system reminders. Returns (text, number of lines)."""
    out = []
    for line in Path(f).read_text(errors="replace").splitlines():
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if o.get("type") not in ("user", "assistant") or o.get("isSidechain") or o.get("isMeta"):
            continue
        c = (o.get("message") or {}).get("content")
        blocks = [{"type": "text", "text": c}] if isinstance(c, str) else (c or [])
        who = "You" if o["type"] == "user" else "Claude"
        parts = []
        for b in blocks:
            if b.get("type") == "text":
                t = re.sub(r"<system-reminder>.*?</system-reminder>", "", b.get("text", ""), flags=re.S).strip()
                if t and not t.startswith(("<command-", "<local-command", "Caveat:")):
                    parts.append(t)
            elif b.get("type") == "tool_use":
                parts.append(tool_summary(b))
        if parts:
            out += [f"### {who}", *parts, ""]
    text = "\n".join(out).rstrip() + "\n" if out else ""
    return text, len(text.splitlines())


def cmd_copy_pane(a):
    """M-y: a Claude pane: the whole conversation from Claude's session file (Claude redraws its screen, so tmux's scrollback doesn't hold it);
    any other pane: the whole scrollback, trailing blank lines trimmed. Local client: clipboard. Remote: a file in the outbox."""
    text = ""
    f = claude_session_file(a.pane)
    if f:
        try:
            text, n = transcript_text(f)
        except OSError:
            text = ""
    if not text:
        out = tmux("capture-pane", "-p", "-J", "-S", "-", "-E", "-", "-t", a.pane, check=False).stdout
        lines = [l.rstrip() for l in out.splitlines()]
        while lines and not lines[-1]:
            lines.pop()
        text = "\n".join(lines) + "\n"
        n = len(lines)
    if not client_is_remote(a.client_pid):
        try:
            wl_copy(text)
            return tmux_msg(a.client, f"copied {n} lines")
        except (RuntimeError, OSError, subprocess.SubprocessError) as e:
            why = f"clipboard failed ({e}); "
    else:
        why = ""
    d = STATE_DIR / "outbox"
    d.mkdir(parents=True, exist_ok=True)
    f = d / f"{a.session}-{time.strftime('%Y%m%d-%H%M%S')}.txt"
    f.write_text(text)
    f.chmod(0o600)
    tmux_msg(a.client, f"{why}saved {n} lines: {home_rel(f)}")


# ---------- Align: the facts ALIGN.md compares the project's docs against ----------
def align_facts(path):
    """Facts about the real repo, as text, for ALIGN.md: visibility (gh), docs layout, tests, ignores, the hyperbeam wiring, and doc lines that
    look like claims about visibility (so a stale one can be spotted against the real visibility)."""
    path = Path(path)
    out = []
    r = subprocess.run(["gh", "repo", "view", "--json", "nameWithOwner,visibility", "-q", ".nameWithOwner + \" \" + .visibility"], cwd=path,
                       capture_output=True, text=True, timeout=15) if shutil.which("gh") else None
    vis = r.stdout.strip().split()[-1].lower() if r and r.returncode == 0 and r.stdout.strip() else ""
    out.append(f"repo on GitHub: {r.stdout.strip()}" if vis else "repo on GitHub: unknown (no gh, no remote, or not logged in)")

    def has(*names):
        return [n for n in names if (path / n).exists()]
    out.append("hyperbeam files: " + (", ".join(has("CLAUDE.md", "README.md", "docs/DECISIONS.md", "PRIVATE.md")) or "none of CLAUDE.md, README.md, docs/DECISIONS.md, PRIVATE.md"))
    docs = sorted(str(f.relative_to(path)) for f in (path / "docs").rglob("*.md")) if (path / "docs").is_dir() else []
    out.append("docs/: " + (", ".join(docs[:30]) or "none"))
    like = [str(f.relative_to(path)) for f in path.glob("*.md") if re.search(r"decision|adr|architecture|design|product|spec|notes", f.name, re.I)] \
        + [d for d in docs if re.search(r"decision|adr|architecture|design|product|model|spec", d, re.I) and not d.endswith("DECISIONS.md")]
    out.append("other decision/design-like docs (how do they relate to docs/DECISIONS.md?): " + (", ".join(like) or "none"))
    claude = (path / "CLAUDE.md").read_text(errors="replace") if (path / "CLAUDE.md").is_file() else ""
    out.append("CLAUDE.md imports the rules (@.hyperbeam/RULES.md): " + ("yes" if "@.hyperbeam/RULES.md" in claude else "no"))
    out.append("CLAUDE.md has an 'Exceptions to hyperbeam rules' section: " + ("yes" if re.search(r"^#+\s*Exceptions to hyperbeam rules", claude, re.M | re.I) else "no"))
    tests = []
    pj = path / "package.json"
    if pj.is_file():
        try:
            sc = json.loads(pj.read_text()).get("scripts", {})
            tests += [f"package.json script `{k}`" for k in sc if re.search(r"test|e2e|lint|check", k)]
        except ValueError:
            pass
    tests += [n for n in has("tests", "test", "pytest.ini", "vitest.config.ts", "vitest.e2e.config.ts", "playwright.config.ts", "tox.ini", "Makefile") ]
    out.append("tests: " + (", ".join(tests) or "none found"))
    dock = [str(f.relative_to(path)) for f in list(path.glob("docker-compose*")) + list(path.glob("compose*.y*ml")) + list(path.glob("tests/**/docker-compose*"))[:5]]
    out.append("docker compose files (Docker-based tests are an exception, never run in the lab): " + (", ".join(dock) or "none"))
    gi = (path / ".gitignore").read_text(errors="replace").splitlines() if (path / ".gitignore").is_file() else []
    envs = [f.name for f in path.glob(".env*") if not f.name.endswith((".example", ".sample"))]
    out.append(f".gitignore: {'has' if any(l.strip().startswith('.env') for l in gi) else 'no'} .env rule; env files present: {', '.join(envs) or 'none'}"
               + ("; steno-*.txt rule: " + ("yes" if any("steno" in l for l in gi) else "no")))
    claims = []
    for fn in ("CLAUDE.md", "README.md"):
        f = path / fn
        if f.is_file():
            for i, l in enumerate(f.read_text(errors="replace").splitlines(), 1):
                if re.search(r"\b(not public|private repo|private repository|closed[- ]source|internal only|public repo|open[- ]source|is public|is private)\b", l, re.I):
                    claims.append(f"{fn}:{i}: {l.strip()[:140]}")
    out.append("lines that claim public/private" + (f" (real visibility: {vis})" if vis else "") + ": " + ("; ".join(claims[:6]) or "none"))
    return "\n".join(f"- {x}" for x in out)


