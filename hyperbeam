def ago(ts):
    s = int(time.time() - ts)
    return "now" if s < 60 else f"{s // 60}m" if s < 3600 else f"{s // 3600}h" if s < 86400 else f"{s // 86400}d"


# ---------- session start / stop ----------
def port_open(port):
    try:
        socket.create_connection(("127.0.0.1", port), timeout=0.5).close()
        return True
    except OSError:
        return False


def listeners(port):
    return run("ss", "-ltnpH", f"sport = :{port}")


def wait_ready(sess, win, svc, port):
    """Wait for a service. ready_port defaults to the project port; `ready_port = false` skips the check;
    with only ready_delay it just sleeps."""
    if "ready_delay" in svc:
        time.sleep(svc["ready_delay"])
    rp = svc.get("ready_port")
    if rp is None and "ready_delay" not in svc:
        rp = port
    if rp is None or rp is False:
        return "started" if "ready_delay" not in svc else f"waited {svc['ready_delay']}s"
    deadline = time.time() + svc.get("ready_timeout", 120)
    while time.time() < deadline:
        if port_open(rp):
            return f"port {rp} open"
        pane = tmux("capture-pane", "-p", "-t", f"{sess}:{win}", check=False).stdout
        if re.search(r"\[hyperbeam\] exited: \d+", pane):
            return f"port {rp} open" if port_open(rp) else f"WARNING exited before port {rp} opened"
        time.sleep(0.5)
    return f"WARNING timeout waiting for port {rp}"


def session_env(man, name=None):
    """Environment of a project's session: HB_PROJECT, PORT and HB_PORT (only if the project has a port), HOST=0.0.0.0, then the
    manifest's [env] table. `man` may be None (no manifest)."""
    man = man or {}
    env = {"HOST": "0.0.0.0"}
    if name:
        env["HB_PROJECT"] = name
    if man.get("port"):
        env["PORT"] = env["HB_PORT"] = str(man["port"])
    env.update({k: str(v) for k, v in man.get("env", {}).items()})
    return env


def manifest_path(man):
    return Path(os.path.expanduser(man["path"]))


def session_exists(sess):
    return tmux("has-session", "-t", f"={sess}", check=False).returncode == 0


def clean_server_env():
    """A tmux server that hyperbeam (run through uv) started before this fix has uv's environment in its global environment,
    and every new session inherits it. Remove it there too."""
    for k in ("VIRTUAL_ENV", "UV", "UV_RUN_RECURSION_DEPTH"):
        tmux("set-environment", "-g", "-u", k, check=False)
    cur = tmux("show-environment", "-g", "PATH", check=False).stdout.strip()
    if cur.startswith("PATH="):
        new = clean_path(cur[5:])
        if new != cur[5:]:
            tmux("set-environment", "-g", "PATH", new, check=False)


# the status segment: red while the session option @hb_alert is set (a red problem), else a quiet yellow one for @hb_note
ALERT = "#{?@hb_alert,#[fg=white]#[bg=red]#[bold] #{@hb_alert} #[default] ,#{?@hb_note,#[fg=black]#[bg=yellow] #{@hb_note} #[default] ,}}"


def tag_session(sess):
    """Mark a session as one of hyperbeam's (the stack keys use the mark) and put the red alert segment and the key hints in its status bar."""
    tmux("set-option", "-t", sess, "@hb", "1")
    base = tmux("show-options", "-gv", "status-right", check=False).stdout.strip()
    tmux("set-option", "-t", sess, "status-right-length", "200")
    tmux("set-option", "-t", sess, "status-right", f"{ALERT}#[fg=#888888]{HINT} #[default]{base}")


def alert_text(findings, notes=()):
    """Status-bar texts: (red text with the command, quiet note text). Each is the first item, how many more."""
    def one(items, prefix, tail=""):
        if not items:
            return ""
        first = clip(items[0].replace("#", ""), 40)
        return f"{prefix}{first}{f' (+{len(items) - 1})' if len(items) > 1 else ''}{tail}"
    return one(findings, "⚠ ", ": hyperbeam fix"), one(notes, "note: ")


def sync_alert(name, findings, notes=()):
    """Set or clear the project's status segments: red for problems, yellow for notes (cheap when nothing changed)."""
    sess = sanitize(name)
    red, note = alert_text(findings, notes)
    cur = tmux("show-options", "-t", sess, "-v", "@hb_alert", check=False)
    if cur.returncode != 0 and not session_exists(sess):
        return
    curn = tmux("show-options", "-t", sess, "-v", "@hb_note", check=False).stdout.strip()
    if cur.stdout.strip() == red and curn == note:
        return
    if (red or note) and "@hb_alert" not in tmux("show-options", "-t", sess, "-v", "status-right", check=False).stdout:
        tag_session(sess)                     # a session made before this version: add the segment
    for opt, text in (("@hb_alert", red), ("@hb_note", note)):
        if text:
            tmux("set-option", "-t", sess, opt, text, check=False)
        else:
            tmux("set-option", "-t", sess, "-u", opt, check=False)
    tmux("refresh-client", "-S", check=False)


def pane_tail(target, n=50):
    out = tmux("capture-pane", "-p", "-J", "-S", "-", "-t", target, check=False).stdout.rstrip().splitlines()
    return "\n".join(out[-n:])


PLAN_FIRST = ("**Plan mode first.** If plan mode is not active, call EnterPlanMode before anything else: this step is planned by Opus, and nothing is changed "
              "until the user approves your plan.\n\n")


def write_prompt(sess, text):
    d = project_dir(session_project(sess)) / "prompts"
    d.mkdir(parents=True, exist_ok=True)
    f = d / f"{sess}-{time.strftime('%Y%m%d-%H%M%S')}.md"
    f.write_text(PLAN_FIRST + text)
    f.chmod(0o600)
    return f


def investigate_prompt(name, path, sess, reason, failures, findings=()):
    """ONBOARDING.md plus the facts about this project and what went wrong. Written to a file; returns its path."""
    mp = MANIFESTS / f"{name}.toml"
    ctx = [f"Project name: {name}", f"Project path: {path}",
           f"Manifest: {mp if mp.exists() else 'none'}" + ("" if mp.exists() else f" (write it to {mp} once the user approves)"),
           f"tmux session: {sess} (you are in its Claude pane; start services in new windows of this session)",
           f"Why you were started: {reason}"]
    for f in failures:
        ctx.append(f"\nService `{f['name']}` failed: {f['result']}\nLast lines of its window:\n```\n{f['tail'] or '(empty)'}\n```")
    if findings:
        ctx.append("\nStart check findings:\n" + "\n".join(f"- {x}" for x in findings))
    try:
        facts = align_facts(path)
    except (OSError, subprocess.SubprocessError):
        facts = "- (could not gather)"
    ctx.append("\nAlignment facts (gathered by hyperbeam, for ALIGN.md below):\n" + facts)
    return write_prompt(sess, (HERE / "ONBOARDING.md").read_text() + "\n\n---\n\n" + (HERE / "ALIGN.md").read_text() + "\n\n---\n" + "\n".join(ctx) + "\n")


def recover_prompt(name, path, sess, findings):
    ctx = [f"Project name: {name}", f"Project path: {path}", f"tmux session: {sess}", "", "Start check findings:"] + [f"- {x}" for x in findings]
    return write_prompt(sess, (HERE / "RECOVER.md").read_text() + "\n\n---\n" + "\n".join(ctx) + "\n")


def wrapup_prompt(results, sess):
    ctx = ["Projects checked (findings per project; values of secrets are never shown):", ""]
    for r in results:
        ctx += [format_wrapup(r, cap=40), f"  path: {r['path']}", ""]
    return write_prompt(sess, (HERE / "WRAPUP.md").read_text() + "\n\n---\n" + "\n".join(ctx))


def find_claude_pane(sess):
    """The pane for Claude: the one running claude; else the left pane of window `work` in a project session, or the first non-menu pane of
    the hyperbeam session's home window. Never the menu pane: text sent to it would be keystrokes for the menu."""
    rows = [l.split("\t") for l in tmux("list-panes", "-s", "-t", f"={sess}", "-F",
                                        "#{pane_id}\t#{pane_current_command}\t#{window_name}\t#{pane_index}\t#{pane_start_command}",
                                        check=False).stdout.splitlines()]
    if sess == MENU:
        rows = [r for r in rows if r[2] in ("home", "hyperbeam") and "_menu" not in r[4]]      # "hyperbeam" = the window of the old layout
        return next((r[0] for r in rows if r[1] == "claude"), None) or (rows[0][0] if rows else None)
    return (next((r[0] for r in rows if r[1] == "claude"), None)
            or next((r[0] for r in rows if r[2] == "work"), None) or (rows[0][0] if rows else None))


def start_wrapup(sess, results):
    """Wrap-up findings to Claude in the session's Claude pane (inject_prompt). Returns the pane id."""
    pane = find_claude_pane(sess)
    if not pane:
        raise RuntimeError(f"no pane to start Claude in {sess}")
    here = tmux("display-message", "-p", "-t", pane, "#{pane_current_path}").stdout.strip()
    inject_prompt(pane, wrapup_prompt(results, sess), [r["path"] for r in results if Path(r["path"]) != Path(here)])
    tmux("select-window", "-t", pane, check=False)
    tmux("select-pane", "-t", pane, check=False)
    return pane


def claude_base(plan=False):
    """Every Claude hyperbeam starts uses the configured model, effort and permissions. plan: it starts in plan mode (injected prompts); with
    permissions "skip" bypass is then only allowed, so approving the plan can switch to it (both flags together would leave the mode unclear)."""
    skip = cfg_get("claude_permissions") == "skip"
    mode = (" --permission-mode plan" + (" --allow-dangerously-skip-permissions" if skip else "")) if plan else (" --dangerously-skip-permissions" if skip else "")
    return f"claude --model {cfg_get('claude_model')} --effort {cfg_get('claude_effort')}{mode}"


def claude_cmd(prompt_file=None, cont=False, add_dir=False):
    """Plain `claude`, or claude with an initial prompt read from a file. cont: `claude --continue` (the most recent conversation in this
    directory; it takes a prompt too), falling back to a fresh claude if there is none. The prompt comes first: --add-dir takes a list."""
    p = f' "$(cat {shlex.quote(str(prompt_file))})"' if prompt_file else ""
    tail = f" --add-dir {shlex.quote(str(HERE))}" if add_dir else ""
    fresh = f"{claude_base()}{p}{tail}"
    return f"{claude_base()} --continue{p}{tail} || {fresh}" if cont else fresh


def pane_command(pane):
    return tmux("display-message", "-p", "-t", pane, "#{pane_current_command}", check=False).stdout.strip()


def inject_prompt(pane, f, add_dirs=()):
    """The one way a prompt file reaches Claude (recover, wrap-up, onboarding). Always in plan mode, so with opusplan Opus makes the proposal and
    Sonnet only builds after the user approves. Claude already running in the pane: `/plan` plus one line pointing at the file, then Enter.
    Otherwise start `claude --permission-mode plan --continue` with the prompt, falling back to a fresh `claude` if there is no conversation."""
    if pane_command(pane) == "claude":
        send_line(pane, f"/plan Read {f} and follow it.")
        return "injected"
    start_claude_with_prompt(pane, f, add_dirs)
    return "started"


def start_claude_with_prompt(pane, f, add_dirs=(), cont=True):
    """Type the command that starts Claude in plan mode with the prompt file as its first message. cont: `claude --continue` (the last conversation of this
    directory), falling back to a fresh one when there is none; otherwise always a fresh Claude."""
    dirs = "".join(f" --add-dir {shlex.quote(str(d))}" for d in add_dirs)
    arg = f' "$(cat {shlex.quote(str(f))})"{dirs}'
    base = claude_base(plan=True)
    send_line(pane, f"{base} --continue{arg} || {base}{arg}" if cont else f"{base}{arg}")


def send_line(target, text):
    tmux("send-keys", "-t", target, "-l", text)
    tmux("send-keys", "-t", target, "Enter")


# ---------- status dots: red (service down, start-check findings, crash), blue (Claude waits for the user), green ----------
def pfile(name, kind):
    """A per-project state file: status.json, claude (the hooks' state), auto (hash of the problems RECOVER.md was sent for), layout.json."""
    return project_dir(name) / kind


def write_status(name, findings, notes=()):
    """findings = the red ones (merge/rebase with conflicts, secrets in commits); notes = the quiet git state (uncommitted, unpushed, ...)."""
    pfile(name, "status.json").write_text(json.dumps({"v": 2, "findings": list(findings), "notes": list(notes), "time": time.time()}))


def read_status(name):
    try:
        d = json.loads(pfile(name, "status.json").read_text())
    except (OSError, ValueError):
        return {}
    return d if d.get("v") == 2 else {}         # an older file mixed notes into the findings: ignore it until the next check


def clear_status(name):
    for k in ("status.json", "claude", "auto"):
        pfile(name, k).unlink(missing_ok=True)


# ---------- drift: has the project's run setup changed since it was onboarded? (no tokens: a fingerprint of the run-defining parts) ----------
def _names(deps):
    """Package names from a list/dict of dependencies (`requests>=2`, `pkg[extra]; python_version<'3'`, or a name -> version table): versions are noise."""
    items = deps.keys() if isinstance(deps, dict) else deps or []
    return sorted({re.split(r"[\s<>=!~;\[(@]", str(i), 1)[0].strip().lower() for i in items if str(i).strip()})


def _compose_parts(text):
    """service names, images and published ports of a compose file, by indentation (no YAML library: this only needs those three things)."""
    out, svc, in_services, in_ports, base = {}, None, False, False, None
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].rstrip()
        if not line.strip():
            continue
        ind = len(line) - len(line.lstrip())
        t = line.strip()
        if ind == 0:
            in_services, svc, in_ports = t == "services:", None, False
            continue
        if not in_services:
            continue
        if base is None:
            base = ind
        if ind == base and t.endswith(":"):
            svc, in_ports = t[:-1].strip("\"'"), False
            out[svc] = {"image": "", "ports": []}
        elif svc and ind > base:
            if t.startswith("image:"):
                out[svc]["image"] = t[6:].strip().strip("\"'")
            elif t == "ports:":
                in_ports = True
            elif in_ports and t.startswith("- "):
                out[svc]["ports"].append(t[2:].strip().strip("\"'"))
            elif not t.startswith("-"):
                in_ports = False
    return {k: {"image": v["image"], "ports": sorted(v["ports"])} for k, v in sorted(out.items())}


def fingerprint(path):
    """{file: parts} for the run-defining files of a project: what a setup change looks like, without the noise (versions, lockfiles, names)."""
    path, out = Path(path), {}

    def add(rel, parts):
        if parts:
            out[rel] = parts
    for f in sorted(path.glob("package.json")):
        try:
            d = json.loads(f.read_text())
            add(f.name, {"scripts": d.get("scripts", {}), "dependencies": _names(d.get("dependencies")), "devDependencies": _names(d.get("devDependencies")),
                         "workspaces": d.get("workspaces", [])})
        except ValueError:
            pass
    for f in sorted([*path.glob("docker-compose*.y*ml"), *path.glob("compose*.y*ml")]):
        add(f.name, {"services": _compose_parts(f.read_text(errors="replace"))})
    pp = path / "pyproject.toml"
    if pp.is_file():
        try:
            d = tomllib.loads(pp.read_text())
            po = d.get("tool", {}).get("poetry", {})
            add(pp.name, {"scripts": {**d.get("project", {}).get("scripts", {}), **po.get("scripts", {})},
                          "dependencies": _names(d.get("project", {}).get("dependencies")) + [f"poetry:{n}" for n in _names(po.get("dependencies"))],
                          "optional": {k: _names(v) for k, v in {**d.get("project", {}).get("optional-dependencies", {}), **d.get("dependency-groups", {})}.items() if isinstance(v, list)}})
        except tomllib.TOMLDecodeError:
            pass
    for f in sorted(path.glob("requirements*.txt")):
        add(f.name, {"dependencies": _names([l for l in f.read_text(errors="replace").splitlines() if l.strip() and not l.lstrip().startswith(("#", "-"))])})
    if (path / "Procfile").is_file():
        add("Procfile", {"processes": sorted(l.strip() for l in (path / "Procfile").read_text(errors="replace").splitlines() if l.strip() and not l.startswith("#"))})
    if (path / "Makefile").is_file():
        add("Makefile", {"targets": sorted({m.group(1) for m in re.finditer(r"^([A-Za-z0-9][A-Za-z0-9_.-]*)\s*:(?!=)", (path / "Makefile").read_text(errors="replace"), re.M)})})
    for n in (".env.example", ".env.sample", ".env.template"):
        if (path / n).is_file():
            add(n, {"variables": sorted({m.group(1) for m in re.finditer(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=", (path / n).read_text(errors="replace"), re.M)})})
    if (path / "Cargo.toml").is_file():
        try:
            d = tomllib.loads((path / "Cargo.toml").read_text())
            add("Cargo.toml", {"dependencies": _names(d.get("dependencies")), "dev": _names(d.get("dev-dependencies")), "bins": sorted(b.get("name", "") for b in d.get("bin", []))})
        except tomllib.TOMLDecodeError:
            pass
    return out


def fingerprint_file(name, path):
    return project_dir(name, path) / "fingerprint.json"


def take_fingerprint(name, path):
    """Record the run setup as onboarded now (Onboard/Align wrote or confirmed the manifest, or the user pressed Mark as onboarded)."""
    man = MANIFESTS / f"{name}.toml"
    fingerprint_file(name, path).write_text(json.dumps({"date": time.strftime("%Y-%m-%d %H:%M"), "manifest_mtime": man.stat().st_mtime if man.is_file() else 0,
                                                        "parts": fingerprint(path)}, indent=1))


# ---------- review pass: after N merged PRs a plan-mode review of what was merged (REVIEW.md). The record of the last one is docs/reviews/*.md ----------
def read_front(text):
    """The `key: value` lines between the two --- lines at the top of a record (a decision, a review) -> {key: value as a string}."""
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return {}
    out = {}
    for l in lines[1:]:
        if l.strip() == "---":
            break
        k, _, v = l.partition(":")
        if _:
            out[k.strip()] = v.strip()
    return out


def last_review(path):
    """The newest review record of a project (docs/reviews/YYYY-MM-DD.md): its front matter plus `date`, or None."""
    d = Path(path) / "docs" / "reviews"
    files = sorted(d.glob("*.md")) if d.is_dir() else []
    if not files:
        return None
    r = read_front(files[-1].read_text(errors="replace"))
    r.setdefault("date", files[-1].stem[:10])
    return r


def reviews_due(path):
    """(merged PRs since the last review's `through` commit, that review record), or None when the project has no review record (it isn't in the
    review loop yet) or the commit isn't known."""
    r = last_review(path)
    if not r or not r.get("through"):
        return None
    n = git_out(path, "rev-list", "--merges", "--first-parent", "--count", f"{r['through']}..origin/{default_branch(path)}")
    return (int(n), r) if n.isdigit() else None


def review_notes(name, path):
    """One quiet note on the project row: how far it is from the next review. Never red."""
    due = reviews_due(path)
    if not due or not due[0]:
        return []
    n, r = due
    limit = cfg_get("review_after")
    return [f"review due: {n} PRs merged since the last review ({r['date']}); Done offers it" if n >= limit else f"{n} of {limit} PRs since the last review"]


def review_line(path):
    """For `hyperbeam context`: where the project is in the review loop (a new session knows how much room is left), or None."""
    due = reviews_due(path)
    if not due:
        return None
    n, r = due
    return (f"Last review {r['date']} (through {r['through']}" + (f", PRs {r['prs']}" if r.get("prs") else "") + f"); {n} PR{'s' * (n != 1)} merged since; "
            f"a review is offered at {cfg_get('review_after')}.")


def review_facts(path, since):
    """What the review prompt shows: the PRs merged since `since` with the files each changed, decision records added, the size of the change, IDEAS.md."""
    base = f"origin/{default_branch(path)}"
    rows = [l.split(" ", 1) for l in git_out(path, "log", "--merges", "--first-parent", "--reverse", "--format=%h %s", f"{since}..{base}").splitlines() if l.strip()]
    L = [f"Project path: {path}", f"Reviewing from: {since} (the last review's `through`, or the commit you were given)", f"Merged PRs since then: {len(rows)}", ""]
    for h, subj in rows:
        files = git_out(path, "diff", "--name-only", f"{h}^1", h).split()
        L.append(f"- {subj}  [{h}]  files: " + (", ".join(files[:12]) + (f" (+{len(files) - 12} more)" if len(files) > 12 else "") or "none"))
    L += ["", "Size of the change: " + (git_out(path, "diff", "--shortstat", f"{since}..{base}") or "unknown")]
    rec = git_out(path, "diff", "--name-only", "--diff-filter=A", f"{since}..{base}", "--", "docs/decisions").split()
    L += ["", "Decision records added: " + (", ".join(rec) or "none")]
    ideas = Path(path) / "IDEAS.md"
    L += ["", "IDEAS.md:", ideas.read_text(errors="replace").rstrip() if ideas.is_file() else "(none)"]
    last = last_review(path)
    L += ["", "Last review record: " + (json.dumps(last) if last else "none")]
    return "\n".join(L) + "\n"


SNAPSHOT_CAP = 12000          # characters per part of the snapshot


def review_snapshot(name, path):
    """What a fresh Claude needs to not start blind, without the whole repo: CLAUDE.md, the decisions index, IDEAS.md, the last review, the recent history,
    and what the previous session last said (read before the swap). README.md and docs/REFERENCE.md are left for it to read on demand."""
    want = ("CLAUDE.md", "docs/DECISIONS.md", "IDEAS.md", "Last review", "Recent history")
    out = ["## Snapshot of the project (you start from this; read README.md and docs/REFERENCE.md yourself when you need them)"]
    for title, body in context_bundle(name, path, parts_only=True):
        if title in want and body:
            out += ["", f"### {title}", body[:SNAPSHOT_CAP] + ("\n... (cut; read the file)" if len(body) > SNAPSHOT_CAP else "")]
    try:
        last = report_text(name).strip()
        if last:
            out += ["", "### What the previous session last said", last[:2000] + (" ..." if len(last) > 2000 else "")]
    except Exception:
        pass
    return "\n".join(out) + "\n"


def review_text(name, path, since):
    """REVIEW.md, the facts, and the snapshot: everything the review starts from."""
    return (HERE / "REVIEW.md").read_text() + "\n\n---\n" + review_facts(path, since) + "\n---\n" + review_snapshot(name, path)


def review_prompt(name, path, since):
    """review_text written to the prompts folder (with the plan-first line). -> the file."""
    return write_prompt(sanitize(name), review_text(name, path, since))


def review_offered(name):
    """True when Done already offered (or the user postponed) this project's review today."""
    try:
        return json.loads((DATA_DIR / "review-offered.json").read_text()).get(name) == time.strftime("%Y-%m-%d")
    except (OSError, ValueError):
        return False


def review_mark_offered(name):
    f = DATA_DIR / "review-offered.json"
    try:
        d = json.loads(f.read_text())
    except (OSError, ValueError):
        d = {}
    d[name] = time.strftime("%Y-%m-%d")
    try:
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps(d))
    except OSError:
        pass


def previous_claude(name):
    """The conversation `swap_claude` set aside for this project ({session_id, time, why}), or None."""
    try:
        d = json.loads(pfile(name, "previous-claude").read_text())
        return d if re.fullmatch(r"[0-9a-fA-F-]{8,40}", str(d.get("session_id", ""))) else None
    except (OSError, ValueError):
        return None


def swap_claude(name, path, prompt_file, why, add_dirs=()):
    """Replace the project's Claude with a fresh one in plan mode (opusplan: Opus proposes, Sonnet builds after approval) that starts from `prompt_file`.
    The conversation it replaces is remembered (`previous-claude`) so `back_claude` can resume it. Refuses while Claude is working (it would be killed).
    -> (started, message)."""
    sess = sanitize(name)
    pane = find_claude_pane(sess) if session_exists(sess) else None
    if not pane:
        return False, f"{name} is not running: open it, then ask again"
    if claude_state(name)[0] == "working":
        return False, f"Claude is working in {name}: wait until it is idle, then ask again"
    sf = claude_session_file(pane)
    if sf:
        try:
            pfile(name, "previous-claude").write_text(json.dumps({"session_id": sf.stem, "time": time.time(), "why": why}))
        except OSError:
            pass
    tmux("respawn-pane", "-k", "-t", pane, "-c", str(path), check=False)
    start_claude_with_prompt(pane, prompt_file, add_dirs, cont=False)
    tmux("select-window", "-t", pane, check=False)
    tmux("select-pane", "-t", pane, check=False)
    return True, "a fresh Claude in plan mode" + (" (the previous conversation is kept: Previous Claude brings it back)" if sf else "")


def back_claude(name):
    """Resume the conversation `swap_claude` set aside, in the same pane (the swapped-in Claude ends). -> (done, message)."""
    rec = previous_claude(name)
    if not rec:
        return False, "no previous Claude conversation to go back to"
    sess = sanitize(name)
    pane = find_claude_pane(sess) if session_exists(sess) else None
    if not pane:
        return False, f"{name} is not running: open it first"
    if claude_state(name)[0] == "working":
        return False, f"Claude is working in {name}: wait until it is idle"
    tmux("respawn-pane", "-k", "-t", pane, "-c", str(known_path(name)), check=False)
    send_line(pane, f"{claude_base()} --resume {rec['session_id']}")
    pfile(name, "previous-claude").unlink(missing_ok=True)
    tmux("select-window", "-t", pane, check=False)
    tmux("select-pane", "-t", pane, check=False)
    return True, "back in the previous conversation"


def start_review(name, path, since):
    """The review in a fresh plan-mode Claude (swap_claude) that starts from REVIEW.md, the facts and a snapshot. -> (started, message)."""
    f = review_prompt(name, path, since)               # built first: the snapshot includes what the Claude being replaced last said
    ok, msg = swap_claude(name, path, f, "review", [HERE] if name == "hyperbeam" else [])
    if not ok:
        return False, msg
    return True, f"{msg}; it starts from about {len(f.read_text()) // 4000}k tokens of context and proposes one cleanup PR first"


def cmd_review(a):
    """hyperbeam review [PROJECT] [--since COMMIT] [--print]: the review for a project (default $HB_PROJECT) in a fresh plan-mode Claude that replaces the
    project's Claude (`hyperbeam back` returns to the old conversation), or the prompt printed."""
    name = a.project or os.environ.get("HB_PROJECT")
    if not name:
        sys.exit("hyperbeam review: no project (run it in a project session, or give a name)")
    path = known_path(name)
    r = last_review(path)
    since = a.since or (r or {}).get("through")
    if not since:
        sys.exit(f"hyperbeam review: {name} has no review record (docs/reviews/): say where to start, e.g. --since <the merge commit before the first PR to review>")
    if a.print:
        print(PLAN_FIRST + review_text(name, path, since))
        return 0
    ok, msg = start_review(name, path, since)
    print(f"{name}: {msg}")
    return 0 if ok else 1


def cmd_back(a):
    """hyperbeam back [PROJECT]: resume the conversation a review (swap_claude) set aside."""
    name = a.project or os.environ.get("HB_PROJECT")
    if not name:
        sys.exit("hyperbeam back: no project (run it in a project session, or give a name)")
    ok, msg = back_claude(name)
    print(f"{name}: {msg}")
    return 0 if ok else 1


def drift_notes(name, path):
    """A quiet note when the run-defining files changed since the project was onboarded. Projects with a manifest but no fingerprint get a
    baseline now, without a note; a manifest written since the fingerprint counts as onboarding done (new fingerprint, no note). Never red."""
    man = MANIFESTS / f"{name}.toml"
    if not man.is_file() or not Path(path).is_dir():
        return []
    f = fingerprint_file(name, path)
    try:
        old = json.loads(f.read_text())
    except (OSError, ValueError):
        take_fingerprint(name, path)
        return []
    if man.stat().st_mtime > old.get("manifest_mtime", 0) + 0.5:
        take_fingerprint(name, path)
        return []
    now = fingerprint(path)
    changed = []
    for fn in sorted(set(now) | set(old.get("parts", {}))):
        a, b = old.get("parts", {}).get(fn), now.get(fn)
        if a != b:
            what = sorted(k for k in set(a or {}) | set(b or {}) if (a or {}).get(k) != (b or {}).get(k)) if a and b else ["added" if b else "removed"]
            changed.append(f"{fn} ({', '.join(what)})")
    return [f"setup changed since onboarding: {'; '.join(changed)} (Onboard to update)"] if changed else []


def onboarded_on(name, path):
    try:
        return json.loads(fingerprint_file(name, path).read_text()).get("date", "")
    except (OSError, ValueError):
        return ""


