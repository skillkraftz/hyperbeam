#!/usr/bin/env -S /home/andy/.local/bin/uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["textual>=1.0"]
# ///
"""hyperbeam: a control panel for ~/projects. No arguments opens the menu.

CLI (for scripts and SSH): hyperbeam scan | open NAME [-d] | stop NAME | list | phone
(_menu, _stack, _copy-pane, _clip, _warn are internal: tmux bindings and windows call them)
"""
import os
from pathlib import Path

# The code lives in hb/*.py, one file per part (see CLAUDE.md). The parts run in this script's namespace, in this order,
# so it behaves as the one file it was split from (tests and tools patch names on this module).
for _part in ("config", "state", "session", "workers", "checks", "sidebar", "lab", "verify", "verbs", "new", "context", "merge", "info", "menu", "cli"):
    _f = Path(os.path.realpath(__file__)).parent / "hb" / f"{_part}.py"
    exec(compile(_f.read_text(), str(_f), "exec"), globals())
del _part, _f


if __name__ == "__main__":
    main()
