def open_mode():
    """"switch" (default) or "window"; read from config.toml each time so the Settings toggle takes effect at once."""
    try:
        m = tomllib.loads(CONFIG_FILE.read_text()).get("open_mode", "switch")
    except (OSError, tomllib.TOMLDecodeError):
        m = "switch"
    return m if m in ("switch", "window") else "switch"


def set_open_mode(mode):
    """Write open_mode to config.toml, keeping the rest of the file (comments) as it is."""
    text = CONFIG_FILE.read_text()
    line = f'open_mode = "{mode}"'
    if re.search(r"^open_mode\s*=.*$", text, flags=re.M):
        text = re.sub(r"^open_mode\s*=.*$", line, text, flags=re.M)
    else:
        text = text.rstrip("\n") + f'\n# "switch": Open switches this client to the project. "window": a new kitty window per project (at the laptop).\n{line}\n'
    CONFIG_FILE.write_text(text)


def run(*a):
    r = subprocess.run(a, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def tmux(*a, check=True):
    return subprocess.run(["tmux", *a], capture_output=True, text=True, check=check)


def sanitize(name):
    """tmux session name of a project. The project called "hyperbeam" is the menu session itself."""
    return re.sub(r"[.:]", "_", name)


def home_rel(p):
    s = str(p)
    h = str(Path.home())
    return "~" + s[len(h):] if s.startswith(h) else s


# ---------- scan ----------
def owner_of(url):
    if not url:
        return "no remote"
    m = re.search(r"[:/]([^/:]+)/[^/]+?(?:\.git)?/?$", url)
    if not m:
        return "other"
    return "mine" if m.group(1).lower() in ACCOUNTS else "other"


def scan():
    repos = []
    for dp, dns, fns in os.walk(ROOT):
        if ".git" in dns or ".git" in fns:
            repos.append(Path(dp))
        dns[:] = sorted(d for d in dns if d not in SKIP)
    rows = []
    for p in repos:
        url = run("git", "-C", str(p), "remote", "get-url", "origin")
        rows.append(dict(path=p, git=True, remote=url, owner=owner_of(url),
                         dirty=bool(run("git", "-C", str(p), "status", "--porcelain"))))
    for d in sorted(ROOT.iterdir()):
        if d.is_dir() and not d.name.startswith(".") \
                and not any(r["path"] == d or d in r["path"].parents for r in rows):
            rows.append(dict(path=d, git=False, remote="", owner="no git", dirty=False))
    for r in rows:
        r["name"] = str(r["path"].relative_to(ROOT)).replace("/", "_")
    return sorted(rows, key=lambda r: r["name"].lower())


def load_manifests():
    out = {}
    for f in sorted(MANIFESTS.glob("*.toml")):
        try:
            out[f.stem] = tomllib.loads(f.read_text())
        except tomllib.TOMLDecodeError:
            pass
    return out


def running_sessions():
    return set(tmux("list-sessions", "-F", "#{session_name}", check=False).stdout.split())


# ---------- state (last opened) ----------
def load_state():
    try:
        return json.loads((STATE_DIR / "state.json").read_text())
    except (OSError, ValueError):
        return {"opened": {}}


def touch_opened(name):
    st = load_state()
    st.setdefault("opened", {})[name] = time.time()
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    (STATE_DIR / "state.json").write_text(json.dumps(st))


def build_projects():
    mans, run_set, opened = load_manifests(), running_sessions(), load_state().get("opened", {})
    rows = scan()
    for r in rows:
        m = mans.get(r["name"])
        r["manifest"] = m is not None
        r["port"] = m.get("port") if m else None
        r["running"] = sanitize(r["name"]) in run_set
        r["opened"] = opened.get(r["name"], 0)
    return rows


def ago(ts):
    s = int(time.time() - ts)
    return "now" if s < 60 else f"{s // 60}m" if s < 3600 else f"{s // 3600}h" if s < 86400 else f"{s // 86400}d"


# ---------- session start / stop ----------
def port_open(port):
    try:
        socket.create_connection(("127.0.0.1", port), timeout=0.5).close()
        return True
    except OSError:
        return False


def listeners(port):
    return run("ss", "-ltnpH", f"sport = :{port}")


def wait_ready(sess, win, svc, port):
    """Wait for a service. ready_port defaults to the project port; `ready_port = false` skips the check;
    with only ready_delay it just sleeps."""
    if "ready_delay" in svc:
        time.sleep(svc["ready_delay"])
    rp = svc.get("ready_port")
    if rp is None and "ready_delay" not in svc:
        rp = port
    if rp is None or rp is False:
        return "started" if "ready_delay" not in svc else f"waited {svc['ready_delay']}s"
    deadline = time.time() + svc.get("ready_timeout", 120)
    while time.time() < deadline:
        if port_open(rp):
            return f"port {rp} open"
        pane = tmux("capture-pane", "-p", "-t", f"{sess}:{win}", check=False).stdout
        if re.search(r"\[hyperbeam\] exited: \d+", pane):
            return f"port {rp} open" if port_open(rp) else f"WARNING exited before port {rp} opened"
        time.sleep(0.5)
    return f"WARNING timeout waiting for port {rp}"


def session_env(man, name=None):
    """Environment of a project's session: HB_PROJECT, PORT and HB_PORT (only if the project has a port), HOST=0.0.0.0, then the
    manifest's [env] table. `man` may be None (no manifest)."""
    man = man or {}
    env = {"HOST": "0.0.0.0"}
    if name:
        env["HB_PROJECT"] = name
    if man.get("port"):
        env["PORT"] = env["HB_PORT"] = str(man["port"])
    env.update({k: str(v) for k, v in man.get("env", {}).items()})
    return env


def manifest_path(man):
    return Path(os.path.expanduser(man["path"]))


def session_exists(sess):
    return tmux("has-session", "-t", f"={sess}", check=False).returncode == 0


def clean_server_env():
    """A tmux server that hyperbeam (run through uv) started before this fix has uv's environment in its global environment,
    and every new session inherits it. Remove it there too."""
    for k in ("VIRTUAL_ENV", "UV", "UV_RUN_RECURSION_DEPTH"):
        tmux("set-environment", "-g", "-u", k, check=False)
    cur = tmux("show-environment", "-g", "PATH", check=False).stdout.strip()
    if cur.startswith("PATH="):
        new = clean_path(cur[5:])
        if new != cur[5:]:
            tmux("set-environment", "-g", "PATH", new, check=False)


def tag_session(sess):
    """Mark a session as one of hyperbeam's (the stack keys use the mark) and put the key hints in its status bar."""
    tmux("set-option", "-t", sess, "@hb", "1")
    base = tmux("show-options", "-gv", "status-right", check=False).stdout.strip()
    tmux("set-option", "-t", sess, "status-right-length", "120")
    tmux("set-option", "-t", sess, "status-right", f"#[fg=#888888]{HINT} #[default]{base}")


def pane_tail(target, n=50):
    out = tmux("capture-pane", "-p", "-J", "-S", "-", "-t", target, check=False).stdout.rstrip().splitlines()
    return "\n".join(out[-n:])


def investigate_prompt(name, path, sess, reason, failures):
    """ONBOARDING.md plus the facts about this project and what went wrong. Written to a file; returns its path."""
    mp = MANIFESTS / f"{name}.toml"
    ctx = [f"Project name: {name}", f"Project path: {path}",
           f"Manifest: {mp if mp.exists() else 'none'}" + ("" if mp.exists() else f" (write it to {mp} once the user approves)"),
           f"tmux session: {sess} (you are in its `claude` window; start services in new windows of this session)",
           f"Why you were started: {reason}"]
    for f in failures:
        ctx.append(f"\nService `{f['name']}` failed: {f['result']}\nLast lines of its window:\n```\n{f['tail'] or '(empty)'}\n```")
    d = STATE_DIR / "prompts"
    d.mkdir(parents=True, exist_ok=True)
    f = d / f"{sess}-{time.strftime('%Y%m%d-%H%M%S')}.md"
    f.write_text((HERE / "ONBOARDING.md").read_text() + "\n\n---\n" + "\n".join(ctx) + "\n")
    f.chmod(0o600)
    return f


def claude_cmd(prompt_file=None):
    """Plain `claude`, or claude started with the investigate prompt (prompt first: --add-dir takes a list)."""
    if prompt_file is None:
        return "claude"
    return f'claude "$(cat {shlex.quote(str(prompt_file))})" --add-dir {shlex.quote(str(HERE))}'


def send_line(target, text):
    tmux("send-keys", "-t", target, "-l", text)
    tmux("send-keys", "-t", target, "Enter")


def new_pane(args, cmd=None):
    """Run a tmux command that creates a pane (new-session, split-window) and return the new pane's id."""
    return tmux(*args, "-P", "-F", "#{pane_id}", *([cmd] if cmd else [])).stdout.strip()


def ensure_menu():
    """The `hyperbeam` session: menu on the left, Claude (in ~/projects/hyperbeam) top right, a shell bottom right.
    Splits are percentages, so the layout scales when a client of another size attaches."""
    if session_exists(MENU):
        return
    clean_server_env()
    menu = new_pane(["new-session", "-d", "-s", MENU, "-n", "hyperbeam", "-x", "200", "-y", "50", "-c", str(HERE),
                     "-e", "HB_PROJECT=hyperbeam", "-e", "HOST=0.0.0.0"],
                    f"{SELF} _menu; echo; echo '[hyperbeam] menu exited, press Enter'; read")
    claude = new_pane(["split-window", "-h", "-l", "45%", "-t", menu, "-c", str(HERE)])
    shell = new_pane(["split-window", "-v", "-l", "40%", "-t", claude, "-c", str(HERE)])
    send_line(claude, "claude")
    tmux("select-pane", "-t", menu)
    tag_session(MENU)


def start_session(name, man, say=print, path=None, reason=None):
    """Create the project's session. Without a manifest (man is None), or if a service fails, or if `reason` is given
    (Onboard), Claude starts with the investigate prompt instead of plain `claude`.
    Window `work`: Claude on the left, a shell on the right (it runs the warnings, then `kk`); then one window per service."""
    sess = sanitize(name)
    if sess == MENU:
        return ensure_menu()
    path = manifest_path(man) if man else Path(path)
    if not path.is_dir():
        raise RuntimeError(f"{path} does not exist")
    env = session_env(man, name)
    clean_server_env()
    envargs = [x for k, v in env.items() for x in ("-e", f"{k}={v}")]
    claude = new_pane(["new-session", "-d", "-s", sess, "-n", "work", "-x", "200", "-y", "50", "-c", str(path), *envargs])
    shell = new_pane(["split-window", "-h", "-l", "40%", "-t", claude, "-c", str(path)])
    tmux("select-pane", "-t", claude)
    tag_session(sess)
    services = man.get("service", []) if man else []
    if services:
        send_line(claude, "echo '[hyperbeam] starting services; Claude starts when they are done'")
    failures = []
    for svc in services:
        win = svc["name"]
        tmux("new-window", "-d", "-t", f"{sess}:", "-n", win, "-c", str(path))
        send_line(f"{sess}:{win}", f'{svc["cmd"]}; echo "[hyperbeam] exited: $?"')
        say(f"{name}: started {win}, waiting...")
        result = wait_ready(sess, win, svc, man.get("port"))
        say(f"{name}: {win}: {result}")
        if result.startswith("WARNING"):
            failures.append(dict(name=win, result=result, tail=pane_tail(f"{sess}:{win}")))
    send_line(shell, f"clear; {SELF} _warn {shlex.quote(str(path))}; {SELF} info {shlex.quote(name)}")
    if man is None:
        reason = reason or "no manifest"
    elif failures:
        reason = reason or "a service failed to start"
    if reason:
        cmd = claude_cmd(investigate_prompt(name, path, sess, reason, failures))
        say(f"{name}: {reason}; Claude starts with the investigate prompt")
    else:
        cmd = claude_cmd()
    send_line(claude, cmd)
    tmux("select-window", "-t", f"{sess}:work")
    say(f"{name}: session ready" + (f" (PORT={man['port']})" if man and man.get("port") else ""))


def investigate_window(name, path, reason):
    """Onboard on a session that is already running: a new `investigate` window with the prompt."""
    sess = sanitize(name)
    f = investigate_prompt(name, path, sess, reason, [])
    tmux("new-window", "-t", f"{sess}:", "-n", "investigate", "-c", str(path))
    send_line(f"{sess}:investigate", claude_cmd(f))


def own_session():
    """Name of the tmux session this process runs in, or ''."""
    return run("tmux", "display-message", "-p", "#{session_name}") if os.environ.get("TMUX") else ""


def project_ports(man):
    if not man:
        return []
    ports = {man["port"]} if man.get("port") else set()
    ports.update(s["ready_port"] for s in man.get("service", [])
                 if isinstance(s.get("ready_port"), int) and not isinstance(s.get("ready_port"), bool))
    return sorted(ports)


def stop_project(name, man, say=print):
    """Run `stop` commands in reverse order, kill the session, confirm the ports are closed."""
    sess = sanitize(name)
    if sess == MENU or own_session() == sess:
        raise RuntimeError(f"{sess} is the menu session (the menu, Claude and a shell for hyperbeam itself); stop it with `tmux kill-session -t {sess}`")
    path = manifest_path(man) if man else None
    env = dict(os.environ, **session_env(man, name))
    for svc in reversed(man.get("service", []) if man else []):
        if "stop" in svc:
            say(f"{name}: stop {svc['name']}: {svc['stop']}")
            try:
                r = subprocess.run(svc["stop"], shell=True, cwd=path, env=env, capture_output=True, text=True, timeout=120)
                if r.returncode:
                    say(f"{name}: WARNING stop {svc['name']} exited {r.returncode}: {(r.stderr or r.stdout).strip()[-200:]}")
            except subprocess.TimeoutExpired:
                say(f"{name}: WARNING stop {svc['name']} timed out")
    if session_exists(sess):
        tmux("kill-session", "-t", f"={sess}", check=False)
        say(f"{name}: session killed")
    deadline = time.time() + 6
    ports = project_ports(man)
    while time.time() < deadline and any(listeners(p) for p in ports):
        time.sleep(0.5)
    left = [(p, listeners(p)) for p in ports if listeners(p)]
    if left:
        for p, info in left:
            say(f"{name}: WARNING port {p} still listening: {info.split(chr(10))[0][:120]}")
        return False
    say(f"{name}: stopped" + (f"; ports {', '.join(map(str, ports))} are free" if ports else " (no manifest: no ports to check)"))
    return True


# ---------- showing a session ----------
def is_remote():
    return bool(os.environ.get("SSH_CONNECTION") or os.environ.get("SSH_TTY")) \
        or not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))


def attach_here(sess):
    """Switch or attach in the current terminal (used over SSH and by the CLI)."""
    if os.environ.get("TMUX"):
        return subprocess.run(["tmux", "switch-client", "-t", sess]).returncode
    return subprocess.run(["tmux", "attach", "-t", sess]).returncode


# ---------- the menu session, the stack, copy ----------
def menu_client(field="client_name"):
    """The client that is looking at the menu session (the most recently active one): its name (tty) or another format field; '' if none."""
    rows = [l.split(None, 1) for l in tmux("list-clients", "-t", f"={MENU}", "-F", "#{client_activity} #{" + field + "}",
                                          check=False).stdout.splitlines()]
    rows = [r for r in rows if len(r) == 2]
    return max(rows, key=lambda r: int(r[0]))[1] if rows else ""


def display_env():
    """Environment for a GUI program started from the tmux server (which may have been started over SSH): remove TMUX, find the Wayland socket."""
    env = dict(os.environ)
    env.pop("TMUX", None)
    rt = env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    if not env.get("WAYLAND_DISPLAY") and not env.get("DISPLAY"):
        socks = [x for x in sorted(Path(rt).glob("wayland-[0-9]*")) if not x.name.endswith(".lock")]
        if socks:
            env["WAYLAND_DISPLAY"] = socks[0].name
    return env


def spawn_kitty(sess):
    """open_mode = "window": a new kitty window attached to the session. HB_KITTY_ARGS adds kitty options (used by tests)."""
    subprocess.Popen(["kitty", "--title", f"hyperbeam: {sess}", *shlex.split(os.environ.get("HB_KITTY_ARGS", "")),
                      "tmux", "attach", "-t", f"={sess}"],
                     env=display_env(), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def show_session(sess):
    """Show a session. switch mode (default), or window mode over SSH (no kitty to open): switch the client that is looking at the menu.
    window mode at the laptop: a new kitty window. Returns what it did."""
    pid = menu_client("client_pid")
    if not pid:
        raise RuntimeError("no client is attached to the menu session")
    if open_mode() == "window" and not client_is_remote(pid):
        spawn_kitty(sess)
        return "new kitty window"
    tmux("switch-client", "-c", menu_client(), "-t", f"={sess}")
    return "switched"


def source_conf():
    """Load hyperbeam.conf into the running tmux server (tmux.conf also sources it at server start)."""
    tmux("source-file", "-q", str(HERE / "hyperbeam.conf"), check=False)


def stack():
    """The session stack: the menu, then hyperbeam's project sessions in the order they were created."""
    fmt = "#{session_created}\t#{session_name}\t#{@hb}"
    rows = sorted(l.split("\t") for l in tmux("list-sessions", "-F", fmt, check=False).stdout.splitlines())
    names = [r[1] for r in rows if len(r) == 3 and r[2] == "1" and r[1] != MENU]
    return ([MENU] if session_exists(MENU) else []) + names


def client_is_remote(pid):
    """Is the tmux client with this pid on an SSH/mosh connection? Looks at its environment and its ancestors."""
    try:
        env = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        if any(e.startswith((b"SSH_CONNECTION=", b"SSH_TTY=")) for e in env):
            return True
    except OSError:
        pass
    p = int(pid)
    for _ in range(40):
        try:
            stat = Path(f"/proc/{p}/stat").read_text()
        except OSError:
            break
        comm = stat[stat.index("(") + 1:stat.rindex(")")]
        if comm.startswith(("sshd", "mosh-server", "tailscaled")):
            return True
        p = int(stat[stat.rindex(")") + 2:].split()[1])
        if p <= 1:
            break
    return False


def wl_copy(text):
    """Put text on the Wayland clipboard. A tmux server that was started over SSH has no WAYLAND_DISPLAY: use the socket."""
    env = dict(os.environ)
    rt = env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    if not env.get("WAYLAND_DISPLAY"):
        socks = sorted(Path(rt).glob("wayland-[0-9]*"))
        socks = [x for x in socks if not x.name.endswith(".lock")]
        if not socks:
            raise RuntimeError("no Wayland display")
        env["WAYLAND_DISPLAY"] = socks[0].name
    subprocess.run(["wl-copy"], input=text.encode(), env=env, stdin=None, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, timeout=5, check=True)


def tmux_msg(client, msg):
    tmux("display-message", "-c", client, msg, check=False)


def cmd_stack(a):
    names = stack()
    if len(names) < 2:
        return tmux_msg(a.client, "stack: only one session")
    step = 1 if a.direction == "next" else -1
    i = (names.index(a.session) + step) % len(names) if a.session in names else (0 if step > 0 else -1)
    tmux("switch-client", "-c", a.client, "-t", f"={names[i]}")
    tmux_msg(a.client, f"stack {names.index(names[i]) + 1}/{len(names)}: {names[i]}")


def cmd_copy_pane(a):
    """M-y: the pane's whole scrollback, trailing blank lines trimmed. Local client: clipboard. Remote: a file in the outbox."""
    out = tmux("capture-pane", "-p", "-J", "-S", "-", "-E", "-", "-t", a.pane, check=False).stdout
    lines = [l.rstrip() for l in out.splitlines()]
    while lines and not lines[-1]:
        lines.pop()
    text = "\n".join(lines) + "\n"
    n = len(lines)
    if not client_is_remote(a.client_pid):
        try:
            wl_copy(text)
            return tmux_msg(a.client, f"copied {n} lines")
        except (RuntimeError, OSError, subprocess.SubprocessError) as e:
            why = f"clipboard failed ({e}); "
    else:
        why = ""
    d = STATE_DIR / "outbox"
    d.mkdir(parents=True, exist_ok=True)
    f = d / f"{a.session}-{time.strftime('%Y%m%d-%H%M%S')}.txt"
    f.write_text(text)
    f.chmod(0o600)
    tmux_msg(a.client, f"{why}saved {n} lines: {home_rel(f)}")


def cmd_clip(a):
