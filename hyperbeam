    def _load(self):
        rows = build_projects()
        status = self.compute_status(rows, self.recheck_next)
        self.recheck_next = False
        self.call_from_thread(self.apply, rows, status)

    def compute_status(self, rows, recheck_all=False):
        mans = load_manifests()
        if recheck_all:
            for r in rows:
                if r["running"]:
                    recheck(r["name"], manifest_path(mans[r["name"]]) if r["name"] in mans else r["path"])
        return {r["name"]: project_status(r["name"], mans.get(r["name"])) for r in rows if r["running"]}

    def apply(self, rows, status):
        self.projects, self.status = rows, status
        self.refresh_list()
        if not self.keep_notice:
            self.say(f"{len(rows)} projects, {sum(1 for r in rows if r['running'])} running")

    def poll_running(self):
        run_set = running_sessions()
        changed = False
        for p in self.projects:
            now = sanitize(p["name"]) in run_set
            changed |= now != p["running"]
            p["running"] = now
        if changed:
            self.poll_status()

    def poll_status(self):
        def work():
            mans, changed = load_manifests(), False          # a manifest written or committed since the last scan shows up (port, "unset")
            for p in self.projects:
                m = mans.get(p["name"])
                now = (m is not None, m.get("port") if m else None)
                if (p["manifest"], p["port"]) != now:
                    p["manifest"], p["port"] = now
                    changed = True
            st = self.compute_status(self.projects)
            if st != self.status or changed:
                self.call_from_thread(self.set_status, st)
        self.run_worker(work, thread=True, group="status")

    def set_status(self, st):
        self.status = st
        self.refresh_list()

    # --- the list: running, then recent, then the rest; alphabetical within each ---
    def ordered(self):
        days = cfg_get("recent_days")
        now = time.time()
        for p in self.projects:
            p["recent"] = bool(p["opened"]) and now - p["opened"] < days * 86400
        return sorted(self.projects, key=lambda p: (0 if p["running"] else 1 if p["recent"] else 2, p["name"].lower()))

    def refresh_list(self):
        ol = self.query_one("#list", OptionList)
        keep = self.current()
        ol.clear_options()
        rows = self.ordered()
        width = max(20, self.size.width - 2 - 1)    # the option's own padding, the 1-column scrollbar
        for p in rows:
            note = self.repo[0] if p["name"] == "hyperbeam" else ""
            ol.add_option(Option(row_text(p, self.status.get(p["name"]) if p["running"] else None, width, note), id=p["name"]))
        if rows:
            names = [p["name"] for p in rows]
            ol.highlighted = names.index(keep["name"]) if keep and keep["name"] in names else 0
        self.show_why()

    def current(self):
        ol = self.query_one("#list", OptionList)
        if ol.highlighted is None or ol.highlighted >= ol.option_count:
            return None
        name = ol.get_option_at_index(ol.highlighted).id
        return next((p for p in self.projects if p["name"] == name), None)

    def show_why(self):
        p, why = self.current(), ""
        st = self.status.get(p["name"]) if p and p["running"] else None
        self.set_class(bool(st and st[0] == "red"), "fix")          # a red project gets a Fix button
        if st:
            why = f"[{st[0]}] {st[1]}"
        elif p and p["name"] == "hyperbeam" and self.repo[1]:
            why = self.repo[1]
        elif p and not p["manifest"]:
            why = "no manifest: Open starts Claude to set it up"
        w = self.query_one("#why", Static).size.width or 40
        self.query_one("#why", Static).update(clip(why, w - 2))

    def say(self, msg):
        self.query_one("#notice", Static).update(msg)

    def say_from_thread(self, msg):
        self.call_from_thread(self.say, msg)

    # --- events ---
    # Messages bubble from any screen up to the App, so every handler here checks that it came from the main list or the main buttons.
    def on_option_list_option_highlighted(self, event):
        if event.option_list.id == "list":
            self.show_why()

    def on_option_list_option_selected(self, event):
        if event.option_list.id == "list":
            self.action_open()

    def on_button_pressed(self, event):
        if event.button.id and event.button.id.startswith("b-"):
            getattr(self, "action_" + event.button.id[2:])()

    def check_action(self, action, parameters):
        """The Menu's keys do nothing while any other screen (Settings, a question) is up."""
        if action in ("open", "stop", "done", "settings", "fix", "update", "onboard", "info", "refresh", "quit") and len(self.screen_stack) > 1:
            return False
        return True

    def action_fix(self):
        p = self.current()
        st = self.status.get(p["name"]) if p and p["running"] else None
        if not st or st[0] != "red":
            return self.say("Fix: the selected project is not red.")
        if p["name"] in self.busy:
            return self.say(f"{p['name']} is busy.")
        self.busy.add(p["name"])
        self.run_worker(lambda: self._fix(p), thread=True)

    def _fix(self, p):
        name = p["name"]
        try:
            man = load_manifests().get(name)
            fix_project(name, man, manifest_path(man) if man else p["path"])
            show_session(sanitize(name))
            self.say_from_thread(f"{name}: Claude is looking at it (recover prompt).")
        except Exception as e:
            self.say_from_thread(f"{name}: ERROR {e}")
        finally:
            self.busy.discard(name)
            self.call_from_thread(self.reload, True)

    def action_settings(self):
        self.push_screen(SettingsScreen())

    # --- actions ---
    def action_open(self):
        p = self.current()
        if not p:
            return self.say("Nothing selected.")
        if p["name"] in self.busy:
            return self.say(f"{p['name']} is busy.")
        self.busy.add(p["name"])
        self.run_worker(lambda: self._open(p), thread=True)

    def ask(self, text):
        """Ask y/n in a modal; called from a worker thread, blocks until answered."""
        done, box = threading.Event(), []
        self.call_from_thread(self.push_screen, Confirm(text), lambda v: (box.append(bool(v)), done.set()))
        done.wait()
        return box[0]

    def _open(self, p, onboard=False):
        """Open: start the session if needed (asking about the saved layout and the start check; no manifest or a failing start lands in
        Claude with the investigate prompt), then show it. Onboard forces the investigate prompt."""
        name, sess = p["name"], sanitize(p["name"])
        try:
            open_project(name, p["path"], load_manifests().get(name), self.ask, self.say_from_thread, onboard)
            touch_opened(name)
            how = show_session(sess)
            self.say_from_thread(f"{name}: {how} ({HINT})")
        except Exception as e:
            self.say_from_thread(f"{name}: ERROR {e}")
        finally:
            self.busy.discard(name)
            self.call_from_thread(self.reload, True)

    def save_layouts(self):
        self.run_worker(save_all, thread=True, group="save")

    def choose(self, text, options):
        """Like ask(): a modal with several buttons, from a worker thread; returns the chosen id."""
        done, box = threading.Event(), []
        self.call_from_thread(self.push_screen, Choice(text, options), lambda v: (box.append(v), done.set()))
        done.wait()
        return box[0]

    def action_stop(self):
        p = self.current()
        if not p:
            return self.say("Nothing selected.")
        man = load_manifests().get(p["name"])
        if not man and not p["running"]:
            return self.say(f"{p['name']} is not running.")
        if p["name"] in self.busy:
            return self.say(f"{p['name']} is busy.")
        self.busy.add(p["name"])
        self.say(f"{p['name']}: checking for unfinished work...")
        self.run_worker(lambda: self._stop(p, man), thread=True)

    def _stop(self, p, man):
        """Stop: the wrap-up check first. Clean: confirm and stop. Not clean: wrap up with Claude, stop anyway, or cancel."""
        name = p["name"]
        try:
            r = check_project(name)
            if r and not wrapup_clean(r):
                pick = self.choose(f"{format_wrapup(r)}\n\nStop {name} anyway?", [
                    ("wrap", "Start Claude to wrap up (w)", "w"), ("stop", "Stop anyway (s)", "s"), ("cancel", "Cancel (c)", "c")])
                if pick == "wrap":
                    start_wrapup(sanitize(name), [r])
                    show_session(sanitize(name))
                    return self.say_from_thread(f"{name}: Claude is wrapping up in its Claude pane. Stop again when it says it's done.")
                if pick != "stop":
                    return self.say_from_thread(f"{name}: not stopped.")
            else:
                ports = ", ".join(map(str, project_ports(man))) or "(none: no manifest)"
                if not self.ask(f"{name}: all clean (nothing uncommitted, unpushed or secret-looking).\n\nStop it? Runs its stop commands in reverse order, "
                                f"kills the tmux session, and checks that port(s) {ports} are free."):
                    return self.say_from_thread(f"{name}: not stopped.")
            stop_project(name, man, self.say_from_thread)
        except Exception as e:
            self.say_from_thread(f"{name}: ERROR {e}")
        finally:
            self.busy.discard(name)
            self.call_from_thread(self.reload, True)

    def action_done(self):
        if "@done" in self.busy:
            return self.say("Done for now is already running.")
        self.busy.add("@done")
        self.say("Done for now: checking every project in the session record...")
        self.run_worker(self._done, thread=True)

    def _done(self):
        """Done for now: the wrap-up check on every project worked on since the menu started. All clean: offer to stop their sessions.
        Otherwise offer Claude (in the hyperbeam session's Claude pane); the user presses Done again when finished."""
        try:
            names = sorted(load_journal()["projects"])
            if not names:
                return self.say_from_thread("Done for now: no project has been opened since the menu started.")
            results = [r for r in (check_project(n) for n in names) if r]
            dirty = [r for r in results if not wrapup_clean(r)]
            if dirty:
                text = "\n\n".join(format_wrapup(r) for r in results)
                if self.choose(f"{text}\n\nStart Claude to wrap up?", [("wrap", "Start Claude to wrap up (w)", "w"), ("close", "Close (c)", "c")]) == "wrap":
                    start_wrapup(MENU, dirty)
                    return self.say_from_thread("Done for now: Claude is wrapping up in the hyperbeam session's Claude pane. Press Done again when it says it's done.")
                return self.say_from_thread("Done for now: not clean, nothing stopped.")
            running = [n for n in names if sanitize(n) != MENU and session_exists(sanitize(n))]
            msg = f"All clean: {', '.join(names)}.\n\n" + (f"Stop these sessions? {', '.join(running)}" if running else "No session of them is running.")
            if running and not self.ask(msg):
                return self.say_from_thread("Done for now: all clean, nothing stopped.")
            for n in running:
                stop_project(n, load_manifests().get(n), self.say_from_thread)
            journal_clear()
            self.say_from_thread("Done for now: all clean" + (f"; stopped {', '.join(running)}" if running else "") + ". Session record cleared.")
        except Exception as e:
            self.say_from_thread(f"Done for now: ERROR {e}")
        finally:
            self.busy.discard("@done")
            self.call_from_thread(self.reload, True)

    def action_onboard(self):
        p = self.current()
        if not p:
            return self.say("Nothing selected.")
        if p["name"] in self.busy:
            return self.say(f"{p['name']} is busy.")
        self.busy.add(p["name"])
        self.run_worker(lambda: self._open(p, onboard=True), thread=True)

    def action_info(self):
        """The same text as `kk`, in a plain tmux window (so mouse-drag copy works), closed with Enter."""
        p = self.current()
        if not p:
            return self.say("Nothing selected.")
        win = f"info-{sanitize(p['name'])}"
        tmux("kill-window", "-t", f"={MENU}:={win}", check=False)
        side = sidebar_client() if os.environ.get("HB_SIDEBAR") else ""
        tmux("new-window", *(["-d"] if side else []), "-t", f"{MENU}:", "-n", win,
             f"{SELF} info {shlex.quote(p['name'])}; echo; read -r -p '[Enter closes this window] '")
        if side:                    # the sidebar's right client looks at `home`: show the info window there
            tmux("switch-client", "-c", side, "-t", f"={MENU}:={win}", check=False)

    def action_update(self):
        """A popup on the client that shows the main area runs `hyperbeam update` (it restarts this menu at the end, so it must not run here)."""
        c = sidebar_client() if os.environ.get("HB_SIDEBAR") else menu_client()
        if not c:
            return self.say("No tmux client to show the update on: run `hyperbeam update` in a terminal.")
        subprocess.Popen(["tmux", "display-popup", "-c", c, "-E", "-w", "90%", "-h", "80%", "-T", " hyperbeam update ",
                          f"{SELF} update; echo; read -r -p '[Enter closes] '"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        self.say("Update running in a popup...")

    def action_quit(self):
        """In the sidebar Quit ends the menu (its window closes with it). In tmux it detaches the client; the menu keeps running there."""
        if os.environ.get("HB_SIDEBAR"):
            return self.exit()
        c = menu_client()
        if c:
            tmux("detach-client", "-t", c, check=False)


MENU_PIDS = STATE_DIR / "menus"


def run_menu():
    """The menu process. It records itself (pid file) so `hyperbeam update` can restart it, and restarts on SIGUSR1 (exit code 75)."""
    MENU_PIDS.mkdir(parents=True, exist_ok=True)
    f = MENU_PIDS / str(os.getpid())
    f.write_text(json.dumps({"home": str(HERE), "sidebar": bool(os.environ.get("HB_SIDEBAR"))}))
    app = Menu()
    try:
        app.run()
    finally:
        f.unlink(missing_ok=True)
    return app.return_code or 0


# ---------- update / try ----------
def repo_state():
    """(branch, commits origin/main is ahead) of the hyperbeam checkout, from what was last fetched (no network)."""
    br = git_out(HERE, "rev-parse", "--abbrev-ref", "HEAD")
    behind = git_out(HERE, "rev-list", "--count", "HEAD..origin/main") if br == "main" else ""
    return br, int(behind) if behind.isdigit() else 0


def repo_note():
    """('branch'|'behind'|'', long text) for the hyperbeam row."""
    br, behind = repo_state()
    if br and br != "main":
        return "branch", f"on branch {br}: `hyperbeam update` goes back to main"
    if behind:
        return "behind", f"origin/main is {behind} commit{'s' * (behind > 1)} ahead: press Update"
    return "", ""


def restart_menus(say=print):
    """Restart the menu processes without touching a project session. Sidebar menus: SIGUSR1 (they exit 75, their loop starts a new one).
    The in-tmux menu: its pane is respawned; the old layout (menu, Claude, shell in one window) gets a `menu` window and loses its menu pane."""
    n = 0
    for f in sorted(MENU_PIDS.glob("*")):
        try:
            info = json.loads(f.read_text())
            pid = int(f.name)
        except (OSError, ValueError):
            continue
        if not pid_alive(pid, "_menu"):
            f.unlink(missing_ok=True)
        elif info.get("sidebar") and info.get("home") == str(HERE):
            os.kill(pid, signal.SIGUSR1)
            n += 1
    if n:
        say(f"menu: restarted {n} sidebar menu process{'es' * (n > 1)}")
    if not session_exists(MENU):
        return
    own = os.environ.get("TMUX_PANE", "")
    rows = [l.split("\t") for l in tmux("list-panes", "-s", "-t", f"={MENU}", "-F", "#{pane_id}\t#{window_name}\t#{pane_start_command}\t#{window_id}",
                                        check=False).stdout.splitlines()]
    menus = [r for r in rows if len(r) == 4 and "_menu" in r[2] and "sh -c" not in r[2]]
    if not any(r[1] == "menu" for r in rows):
        tmux("new-window", "-d", "-t", f"={MENU}:", "-n", "menu", "-c", str(HERE), menu_cmd(), check=False)
        for pane, win, _, wid in menus:
            if pane != own and sum(1 for r in rows if r[3] == wid) > 1:
                tmux("kill-pane", "-t", pane, check=False)
                tmux("rename-window", "-t", wid, "home", check=False)
        say("menu: old single-window layout converted (new `menu` window; the old window is now `home`)")
    else:
        for pane, win, _, _ in menus:
            if pane != own:
                tmux("respawn-pane", "-k", "-t", pane, menu_cmd(), check=False)
                say("menu: in-tmux menu restarted")


def claude_panes():
    """Every Claude pane in a hyperbeam session: [(pane id, session, project, cwd, state)]; state is waiting (idle, blue), working or ''."""
    out = []
    fmt = "#{pane_id}\t#{session_name}\t#{pane_current_command}\t#{pane_current_path}\t#{@hb}"
    for l in tmux("list-panes", "-a", "-F", fmt, check=False).stdout.splitlines():
        pane, sess, cmd, path, hb = (l.split("\t") + [""] * 5)[:5]
        if cmd == "claude" and hb == "1":
            proj = session_project(sess)
            out.append((pane, sess, proj, path, claude_state(proj)[0]))
    return out


def restart_claude(pane, path):
    """Restart Claude in a pane with --continue: the pane gets a fresh shell in its directory, then the command is typed."""
    tmux("respawn-pane", "-k", "-t", pane, "-c", path, check=False)
    send_line(pane, f"{claude_base()} --continue || {claude_base()}")


def do_update(branch=None, yes=False):
    """`hyperbeam update` (main) / `hyperbeam try BRANCH`: switch the hyperbeam checkout, then (with the new code) `_update-finish`."""
    repo = HERE
    if git_out(repo, "status", "--porcelain", "--untracked-files=no"):
        print(f"{repo} has uncommitted changes: commit or stash them first (nothing was changed)")
        return 1
    old, oldb = git_out(repo, "rev-parse", "--short", "HEAD"), git_out(repo, "rev-parse", "--abbrev-ref", "HEAD")
    git_fetch(repo)
    target = branch or "main"
    if target != oldb:
        r = subprocess.run(["git", "-C", str(repo), "checkout", "-q", target], capture_output=True, text=True)
        if r.returncode:
            print(f"cannot check out {target}: {r.stderr.strip()}")
            return 1
    if git_out(repo, "rev-parse", "--verify", "-q", f"origin/{target}"):
        r = subprocess.run(["git", "-C", str(repo), "merge", "--ff-only", "-q", f"origin/{target}"], capture_output=True, text=True)
        if r.returncode:
            print(f"{target} has local commits that are not on origin/{target}; not merged: {r.stderr.strip()}")
    new, newb = git_out(repo, "rev-parse", "--short", "HEAD"), git_out(repo, "rev-parse", "--abbrev-ref", "HEAD")
    print(f"hyperbeam: {oldb} {old} -> {newb} {new}" + ("" if old != new or oldb != newb else "  (already up to date)"))
    if old != new:
        print(git_out(repo, "log", "--oneline", "-15", f"{old}..{new}") or git_out(repo, "log", "--oneline", "-5", new))
    sys.stdout.flush()
    return subprocess.run([str(repo / "hyperbeam"), "_update-finish"] + (["--yes"] if yes else [])).returncode


def cmd_update_finish(a):
    """The steps after the checkout, run by the new code: hooks, tmux config, menus, Claude panes."""
    print("hooks: " + (", ".join(install_hooks()) and "updated" or "already current"))
    if tmux("source-file", "-q", str(HERE / "hyperbeam.conf"), check=False).returncode == 0 and tmux("has-session", check=False).returncode == 0:
        print("tmux: hyperbeam.conf reloaded")
    else:
        print("tmux: no server running, nothing to reload")
    if session_exists(MENU):
        for sess in stack():
            tag_session(sess)       # refresh the key hints in the status bars
    restart_menus()
    own = os.environ.get("TMUX_PANE", "")
    panes = claude_panes()
    if not panes:
        return 0
    print(f"\nClaude panes still running from before the update ({len(panes)}; they keep the old hooks and settings until restarted):")
    for pane, sess, proj, path, state in panes:
        print(f"  {proj:<22} {'idle (blue)' if state == 'waiting' else 'working' if state == 'working' else 'unknown':<12} {pane}{'  (this one: not touched)' if pane == own else ''}")
    idle = [x for x in panes if x[4] == "waiting" and x[0] != own]
    if not idle:
        return 0
    ok = a.yes
    if not ok and sys.stdin.isatty():
        ok = input(f"Restart the {len(idle)} idle one(s) with --continue? [y/N] ").strip().lower() == "y"
    if ok:
        for pane, sess, proj, path, _ in idle:
            restart_claude(pane, path)
            print(f"  restarted {proj}")
    else:
        print("  not restarted (restart working ones yourself when they finish)")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="hyperbeam", description=__doc__)
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("scan", help="list projects").set_defaults(f=cmd_scan)
    o = sub.add_parser("open", help="start a project's session and attach in this terminal")
    o.add_argument("name")
    o.add_argument("-d", "--detach", action="store_true", help="start the session but do not attach")
    o.set_defaults(f=cmd_open)
    s = sub.add_parser("stop", help="run stop commands, kill the session, check the ports")
    s.add_argument("name")
    s.add_argument("--force", action="store_true", help="skip the wrap-up check")
    s.set_defaults(f=cmd_stop)
    sub.add_parser("list", help="numbered list of running sessions with URLs; a number switches to it").set_defaults(f=cmd_list)
    sub.add_parser("phone", help="print the URLs, then attach to the most recently used session").set_defaults(f=cmd_phone)
    i = sub.add_parser("info", help="URLs and endpoints of a project (alias: kk)")
    i.add_argument("project", nargs="?")
    i.set_defaults(f=cmd_info)
    sub.add_parser("_menu").set_defaults(f=lambda _: run_menu())
    sub.add_parser("_right", help="the sidebar's right side: record this tty, exec tmux attach").set_defaults(f=cmd_right)
    hm = sub.add_parser("_home")
    hm.add_argument("client")
    hm.set_defaults(f=cmd_home)
    up = sub.add_parser("update", help="pull main, reinstall hooks, reload tmux, restart the menu, offer to restart idle Claude panes")
    up.add_argument("--yes", action="store_true", help="restart the idle Claude panes without asking")
    up.set_defaults(f=lambda a: do_update(None, a.yes))
    tr = sub.add_parser("try", help="like update, but check out BRANCH in the hyperbeam checkout (`hyperbeam update` returns to main)")
    tr.add_argument("branch")
    tr.add_argument("--yes", action="store_true")
    tr.set_defaults(f=lambda a: do_update(a.branch, a.yes))
