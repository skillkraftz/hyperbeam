def show_session(sess):
    """Show a session. Sidebar menu: switch the sidebar's right client. Otherwise switch the client that is looking at the menu session
    (switch mode, and over SSH), or in window mode at the laptop open a new kitty window. Returns what it did."""
    if os.environ.get("HB_SIDEBAR"):
        c = sidebar_client()
        if not c:
            raise RuntimeError("the sidebar's main area is not attached (close this window and press the hotkey again)")
        tmux("switch-client", "-c", c, "-t", home_target(c) if sess == MENU else f"={sess}")
