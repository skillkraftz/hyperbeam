ORANGE = "#ff9f43"
DOT = {"green": "green", "red": "red", "blue": "dodger_blue1", "cyan": "cyan"}


def clip(text, width):
    return text if len(text) <= width else text[:max(0, width - 1)] + "…"


def row_text(p, st, width, note=""):
    """One list row: dot, name (clipped with … so the dot and port always fit), port right-aligned. `width` is the room for the row."""
    port = str(p["port"]) if p.get("port") else ("-" if p["manifest"] else "unset")
    pstyle = ORANGE if not p["manifest"] else "dim" if not p.get("port") else "cyan"
    if note:                    # the hyperbeam row: "branch" (not on main) or "behind" (origin/main is ahead)
        port, pstyle = note, "yellow"
    room = max(4, width - 2 - 1 - len(port))
    t = Text(no_wrap=True, overflow="crop")
    t.append("● " if st else "  ", style=DOT.get(st[0], "") if st else "")
    t.append(clip(p["name"], room).ljust(room), style="bold white" if p["recent"] else "grey54")
    t.append(" " + port, style=pstyle)
    return t


class ProjectList(OptionList):
    """A click or tap selects; a double click or tap (Textual's click chain count 2) or Enter opens."""
    async def _on_click(self, event) -> None:
        event.prevent_default()         # Textual calls the base class handler too, unless this is called: it would select on every click
        i = event.style.meta.get("option")
        if i is None or self._options[i].disabled:
            return
        self.highlighted = i
        if event.chain >= 2:
            self.action_select()
        event.stop()


class SettingsScreen(ModalScreen):
