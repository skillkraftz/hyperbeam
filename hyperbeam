def offered_digest(d):
    """True once per day per set of candidates: Done offers the tool proposal once, not at every press."""
    f = DATA_DIR / "digest-offered.json"
    key = hashlib.sha1(json.dumps([(c["project"], c["what"]) for c in d["candidates"]]).encode()).hexdigest()[:10]
    try:
        old = json.loads(f.read_text())
    except (OSError, ValueError):
        old = {}
    if old.get("date") == time.strftime("%Y-%m-%d") and old.get("key") == key:
        return True
    try:
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps({"date": time.strftime("%Y-%m-%d"), "key": key}))
    except OSError:
        pass
    return False


