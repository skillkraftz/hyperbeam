"""hyperbeam: a control panel for ~/projects. No arguments opens the menu.

CLI (for scripts and SSH): hyperbeam scan | open NAME [-d] | stop NAME | list | phone
(_menu, _stack, _copy-pane, _clip, _warn are internal: tmux bindings and windows call them)
"""
import argparse, json, os, re, shlex, socket, subprocess, sys, time, tomllib
from pathlib import Path

from rich.text import Text
from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Horizontal, Vertical
from textual.screen import ModalScreen
from textual.widgets import Button, OptionList, Static, Tab, Tabs
from textual.widgets.option_list import Option

HERE = Path(os.path.realpath(__file__)).parent
CFG = tomllib.loads((HERE / "config.toml").read_text())
ROOT = Path(os.path.expanduser(CFG.get("projects_dir", "~/projects")))
MANIFESTS = Path(os.environ.get("HB_MANIFESTS", HERE / "projects"))   # (override is for tests)
ACCOUNTS = {a.lower() for a in CFG["accounts"]}
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "hyperbeam"
SKIP = {"node_modules", ".venv", "venv", "target", "dist", "build", "out", "__pycache__",
        ".next", ".cache", ".tox", "vendor", ".git"}
SELF = shlex.quote(str(HERE / "hyperbeam"))
MENU = "hyperbeam"          # name of the tmux session the menu runs in
HINT = "M-[ M-] stack  M-y copy"     # the keys of hyperbeam.conf, shown in the menu and in the status bar


def run(*a):
    r = subprocess.run(a, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def tmux(*a, check=True):
    return subprocess.run(["tmux", *a], capture_output=True, text=True, check=check)


def sanitize(name):
    """tmux session name of a project. The project called "hyperbeam" must not take the menu's session name."""
    s = re.sub(r"[.:]", "_", name)
    return "hyperbeam-project" if s == MENU else s


def home_rel(p):
    s = str(p)
    h = str(Path.home())
    return "~" + s[len(h):] if s.startswith(h) else s


# ---------- scan ----------
def owner_of(url):
    if not url:
        return "no remote"
    m = re.search(r"[:/]([^/:]+)/[^/]+?(?:\.git)?/?$", url)
    if not m:
        return "other"
    return "mine" if m.group(1).lower() in ACCOUNTS else "other"


def scan():
    repos = []
    for dp, dns, fns in os.walk(ROOT):
        if ".git" in dns or ".git" in fns:
            repos.append(Path(dp))
        dns[:] = sorted(d for d in dns if d not in SKIP)
    rows = []
    for p in repos:
        url = run("git", "-C", str(p), "remote", "get-url", "origin")
        rows.append(dict(path=p, git=True, remote=url, owner=owner_of(url),
                         dirty=bool(run("git", "-C", str(p), "status", "--porcelain"))))
    for d in sorted(ROOT.iterdir()):
        if d.is_dir() and not d.name.startswith(".") \
                and not any(r["path"] == d or d in r["path"].parents for r in rows):
            rows.append(dict(path=d, git=False, remote="", owner="no git", dirty=False))
    for r in rows:
        r["name"] = str(r["path"].relative_to(ROOT)).replace("/", "_")
    return sorted(rows, key=lambda r: r["name"].lower())


def load_manifests():
    out = {}
    for f in sorted(MANIFESTS.glob("*.toml")):
        try:
            out[f.stem] = tomllib.loads(f.read_text())
        except tomllib.TOMLDecodeError:
            pass
    return out


def running_sessions():
    return set(tmux("list-sessions", "-F", "#{session_name}", check=False).stdout.split())


# ---------- state (last opened) ----------
def load_state():
    try:
        return json.loads((STATE_DIR / "state.json").read_text())
    except (OSError, ValueError):
        return {"opened": {}}


def touch_opened(name):
    st = load_state()
    st.setdefault("opened", {})[name] = time.time()
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    (STATE_DIR / "state.json").write_text(json.dumps(st))


def build_projects():
    mans, run_set, opened = load_manifests(), running_sessions(), load_state().get("opened", {})
    rows = scan()
    for r in rows:
        m = mans.get(r["name"])
        r["manifest"] = m is not None
        r["port"] = m.get("port") if m else None
        r["running"] = sanitize(r["name"]) in run_set
        r["opened"] = opened.get(r["name"], 0)
    return rows


def ago(ts):
    s = int(time.time() - ts)
    return "now" if s < 60 else f"{s // 60}m" if s < 3600 else f"{s // 3600}h" if s < 86400 else f"{s // 86400}d"


# ---------- session start / stop ----------
def port_open(port):
    try:
        socket.create_connection(("127.0.0.1", port), timeout=0.5).close()
        return True
    except OSError:
        return False


def listeners(port):
    return run("ss", "-ltnpH", f"sport = :{port}")


def wait_ready(sess, win, svc, port):
    """Wait for a service. ready_port defaults to the project port; `ready_port = false` skips the check;
    with only ready_delay it just sleeps."""
    if "ready_delay" in svc:
        time.sleep(svc["ready_delay"])
    rp = svc.get("ready_port")
    if rp is None and "ready_delay" not in svc:
        rp = port
    if rp is None or rp is False:
        return "started" if "ready_delay" not in svc else f"waited {svc['ready_delay']}s"
    deadline = time.time() + svc.get("ready_timeout", 120)
    while time.time() < deadline:
        if port_open(rp):
            return f"port {rp} open"
        pane = tmux("capture-pane", "-p", "-t", f"{sess}:{win}", check=False).stdout
        if re.search(r"\[hyperbeam\] exited: \d+", pane):
            return f"port {rp} open" if port_open(rp) else f"WARNING exited before port {rp} opened"
        time.sleep(0.5)
    return f"WARNING timeout waiting for port {rp}"


def session_env(man):
    """Environment of a project's session: PORT, HB_PORT, HOST=0.0.0.0, then the manifest's [env] table."""
    env = {"PORT": str(man["port"]), "HB_PORT": str(man["port"]), "HOST": "0.0.0.0"}
    env.update({k: str(v) for k, v in man.get("env", {}).items()})
    return env


def manifest_path(man):
    return Path(os.path.expanduser(man["path"]))


def session_exists(sess):
    return tmux("has-session", "-t", f"={sess}", check=False).returncode == 0


def tag_session(sess):
    """Mark a session as one of hyperbeam's (the stack keys use the mark) and put the key hints in its status bar."""
    tmux("set-option", "-t", sess, "@hb", "1")
    base = tmux("show-options", "-gv", "status-right", check=False).stdout.strip()
    tmux("set-option", "-t", sess, "status-right-length", "120")
    tmux("set-option", "-t", sess, "status-right", f"#[fg=#888888]{HINT} #[default]{base}")


def pane_tail(target, n=50):
    out = tmux("capture-pane", "-p", "-J", "-S", "-", "-t", target, check=False).stdout.rstrip().splitlines()
    return "\n".join(out[-n:])


def investigate_prompt(name, path, sess, reason, failures):
    """ONBOARDING.md plus the facts about this project and what went wrong. Written to a file; returns its path."""
    mp = MANIFESTS / f"{name}.toml"
    ctx = [f"Project name: {name}", f"Project path: {path}",
           f"Manifest: {mp if mp.exists() else 'none'}" + ("" if mp.exists() else f" (write it to {mp} once the user approves)"),
           f"tmux session: {sess} (you are in its `claude` window; start services in new windows of this session)",
           f"Why you were started: {reason}"]
    for f in failures:
        ctx.append(f"\nService `{f['name']}` failed: {f['result']}\nLast lines of its window:\n```\n{f['tail'] or '(empty)'}\n```")
    d = STATE_DIR / "prompts"
    d.mkdir(parents=True, exist_ok=True)
    f = d / f"{sess}-{time.strftime('%Y%m%d-%H%M%S')}.md"
    f.write_text((HERE / "ONBOARDING.md").read_text() + "\n\n---\n" + "\n".join(ctx) + "\n")
    f.chmod(0o600)
    return f


def claude_cmd(prompt_file=None):
    """Plain `claude`, or claude started with the investigate prompt (prompt first: --add-dir takes a list)."""
    if prompt_file is None:
        return "claude"
    return f'claude "$(cat {shlex.quote(str(prompt_file))})" --add-dir {shlex.quote(str(HERE))}'


def send_line(target, text):
    tmux("send-keys", "-t", target, "-l", text)
    tmux("send-keys", "-t", target, "Enter")


def start_session(name, man, say=print, path=None, reason=None):
    """Create the project's session. Without a manifest (man is None), or if a service fails, or if `reason` is given
    (Onboard), the claude window starts with the investigate prompt instead of plain `claude`."""
    sess = sanitize(name)
    path = manifest_path(man) if man else Path(path)
    if not path.is_dir():
        raise RuntimeError(f"{path} does not exist")
    env = session_env(man) if man else {"HOST": "0.0.0.0"}
    envargs = [x for k, v in env.items() for x in ("-e", f"{k}={v}")]
    tmux("new-session", "-d", "-s", sess, "-n", "claude", "-c", str(path), *envargs)
    tag_session(sess)
    services = man.get("service", []) if man else []
    if services:
        send_line(f"{sess}:claude", "echo '[hyperbeam] starting services; Claude starts when they are done'")
    tmux("new-window", "-t", f"{sess}:", "-n", "shell", "-c", str(path))
    send_line(f"{sess}:shell", f"clear; {SELF} _warn {shlex.quote(str(path))}")
    failures = []
    for svc in services:
        win = svc["name"]
        tmux("new-window", "-t", f"{sess}:", "-n", win, "-c", str(path))
        send_line(f"{sess}:{win}", f'{svc["cmd"]}; echo "[hyperbeam] exited: $?"')
        say(f"{name}: started {win}, waiting...")
        result = wait_ready(sess, win, svc, man["port"])
        say(f"{name}: {win}: {result}")
        if result.startswith("WARNING"):
            failures.append(dict(name=win, result=result, tail=pane_tail(f"{sess}:{win}")))
    if man is None:
        reason = reason or "no manifest"
    elif failures:
        reason = reason or "a service failed to start"
    if reason:
        cmd = claude_cmd(investigate_prompt(name, path, sess, reason, failures))
        say(f"{name}: {reason}; Claude starts with the investigate prompt")
    else:
        cmd = claude_cmd()
    send_line(f"{sess}:claude", cmd)
    tmux("select-window", "-t", f"{sess}:claude")
    say(f"{name}: session ready" + (f" (PORT={man['port']})" if man else ""))


def investigate_window(name, path, reason):
    """Onboard on a session that is already running: a new `investigate` window with the prompt."""
    sess = sanitize(name)
    f = investigate_prompt(name, path, sess, reason, [])
    tmux("new-window", "-t", f"{sess}:", "-n", "investigate", "-c", str(path))
    send_line(f"{sess}:investigate", claude_cmd(f))


def own_session():
    """Name of the tmux session this process runs in, or ''."""
    return run("tmux", "display-message", "-p", "#{session_name}") if os.environ.get("TMUX") else ""


def project_ports(man):
    if not man:
        return []
    ports = {man["port"]}
    ports.update(s["ready_port"] for s in man.get("service", [])
                 if isinstance(s.get("ready_port"), int) and not isinstance(s.get("ready_port"), bool))
    return sorted(ports)


def stop_project(name, man, say=print):
    """Run `stop` commands in reverse order, kill the session, confirm the ports are closed."""
    sess = sanitize(name)
    if own_session() == sess:
        raise RuntimeError(f"this menu is running inside {sess}; run Stop from another terminal")
    path = manifest_path(man) if man else None
    env = dict(os.environ, **session_env(man)) if man else dict(os.environ)
    for svc in reversed(man.get("service", []) if man else []):
        if "stop" in svc:
            say(f"{name}: stop {svc['name']}: {svc['stop']}")
            try:
                r = subprocess.run(svc["stop"], shell=True, cwd=path, env=env, capture_output=True, text=True, timeout=120)
                if r.returncode:
                    say(f"{name}: WARNING stop {svc['name']} exited {r.returncode}: {(r.stderr or r.stdout).strip()[-200:]}")
            except subprocess.TimeoutExpired:
                say(f"{name}: WARNING stop {svc['name']} timed out")
    if session_exists(sess):
        tmux("kill-session", "-t", f"={sess}", check=False)
        say(f"{name}: session killed")
    deadline = time.time() + 6
    ports = project_ports(man)
    while time.time() < deadline and any(listeners(p) for p in ports):
        time.sleep(0.5)
    left = [(p, listeners(p)) for p in ports if listeners(p)]
    if left:
        for p, info in left:
            say(f"{name}: WARNING port {p} still listening: {info.split(chr(10))[0][:120]}")
        return False
    say(f"{name}: stopped" + (f"; ports {', '.join(map(str, ports))} are free" if ports else " (no manifest: no ports to check)"))
    return True


# ---------- showing a session ----------
def is_remote():
    return bool(os.environ.get("SSH_CONNECTION") or os.environ.get("SSH_TTY")) \
        or not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))


def attach_here(sess):
    """Switch or attach in the current terminal (used over SSH and by the CLI)."""
    if os.environ.get("TMUX"):
        return subprocess.run(["tmux", "switch-client", "-t", sess]).returncode
    return subprocess.run(["tmux", "attach", "-t", sess]).returncode


# ---------- the menu session, the stack, copy ----------
def menu_client():
    """The client that is looking at the menu session (the most recently active one), or ''."""
    rows = [l.split(None, 1) for l in tmux("list-clients", "-t", f"={MENU}", "-F", "#{client_activity} #{client_name}",
                                          check=False).stdout.splitlines()]
    rows = [r for r in rows if len(r) == 2]
    return max(rows, key=lambda r: int(r[0]))[1] if rows else ""


def show_session(sess):
    """Switch the client that is looking at the menu to `sess`."""
    c = menu_client()
    if not c:
        raise RuntimeError("no client is attached to the menu session")
    tmux("switch-client", "-c", c, "-t", f"={sess}")


def source_conf():
    """Load hyperbeam.conf into the running tmux server (tmux.conf also sources it at server start)."""
    tmux("source-file", "-q", str(HERE / "hyperbeam.conf"), check=False)


def stack():
    """The session stack: the menu, then hyperbeam's project sessions in the order they were created."""
    fmt = "#{session_created}\t#{session_name}\t#{@hb}"
    rows = sorted(l.split("\t") for l in tmux("list-sessions", "-F", fmt, check=False).stdout.splitlines())
    names = [r[1] for r in rows if len(r) == 3 and r[2] == "1" and r[1] != MENU]
    return ([MENU] if session_exists(MENU) else []) + names


def client_is_remote(pid):
    """Is the tmux client with this pid on an SSH/mosh connection? Looks at its environment and its ancestors."""
    try:
        env = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        if any(e.startswith((b"SSH_CONNECTION=", b"SSH_TTY=")) for e in env):
            return True
    except OSError:
        pass
    p = int(pid)
    for _ in range(40):
        try:
            stat = Path(f"/proc/{p}/stat").read_text()
        except OSError:
            break
        comm = stat[stat.index("(") + 1:stat.rindex(")")]
        if comm.startswith(("sshd", "mosh-server", "tailscaled")):
            return True
        p = int(stat[stat.rindex(")") + 2:].split()[1])
        if p <= 1:
            break
    return False


def wl_copy(text):
    """Put text on the Wayland clipboard. A tmux server that was started over SSH has no WAYLAND_DISPLAY: use the socket."""
    env = dict(os.environ)
    rt = env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    if not env.get("WAYLAND_DISPLAY"):
        socks = sorted(Path(rt).glob("wayland-[0-9]*"))
        socks = [x for x in socks if not x.name.endswith(".lock")]
        if not socks:
            raise RuntimeError("no Wayland display")
        env["WAYLAND_DISPLAY"] = socks[0].name
    subprocess.run(["wl-copy"], input=text.encode(), env=env, stdin=None, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, timeout=5, check=True)


def tmux_msg(client, msg):
    tmux("display-message", "-c", client, msg, check=False)


def cmd_stack(a):
    names = stack()
    if len(names) < 2:
        return tmux_msg(a.client, "stack: only one session")
    step = 1 if a.direction == "next" else -1
    i = (names.index(a.session) + step) % len(names) if a.session in names else (0 if step > 0 else -1)
    tmux("switch-client", "-c", a.client, "-t", f"={names[i]}")
    tmux_msg(a.client, f"stack {names.index(names[i]) + 1}/{len(names)}: {names[i]}")


def cmd_copy_pane(a):
    """M-y: the pane's whole scrollback, trailing blank lines trimmed. Local client: clipboard. Remote: a file in the outbox."""
    out = tmux("capture-pane", "-p", "-J", "-S", "-", "-E", "-", "-t", a.pane, check=False).stdout
    lines = [l.rstrip() for l in out.splitlines()]
    while lines and not lines[-1]:
        lines.pop()
    text = "\n".join(lines) + "\n"
    n = len(lines)
    if not client_is_remote(a.client_pid):
        try:
            wl_copy(text)
            return tmux_msg(a.client, f"copied {n} lines")
        except (RuntimeError, OSError, subprocess.SubprocessError) as e:
            why = f"clipboard failed ({e}); "
    else:
        why = ""
    d = STATE_DIR / "outbox"
    d.mkdir(parents=True, exist_ok=True)
    f = d / f"{a.session}-{time.strftime('%Y%m%d-%H%M%S')}.txt"
    f.write_text(text)
    f.chmod(0o600)
    tmux_msg(a.client, f"{why}saved {n} lines: {home_rel(f)}")


def cmd_clip(a):
    """Mouse drag-select: tmux pipes the selection here. Local client: also onto the Wayland clipboard."""
    text = sys.stdin.read()
    if text and not client_is_remote(a.client_pid):
        try:
            wl_copy(text)
        except (RuntimeError, OSError, subprocess.SubprocessError):
            pass


def cmd_menu(_):
    """`hyperbeam` with no arguments: attach to the menu session (creating it if needed)."""
    if own_session() == MENU:
        return run_menu()
    if not session_exists(MENU):
        tmux("new-session", "-d", "-s", MENU, "-n", "menu", f"{SELF} _menu; echo; echo '[hyperbeam] menu exited, press Enter'; read")
        tag_session(MENU)
    source_conf()
    return attach_here(MENU)


# ---------- sessions, URLs, list, phone ----------
_tailnet = []


def tailnet_host():
    """This machine's MagicDNS name (or its Tailscale IP), from `tailscale status --json`; None if unavailable."""
    if not _tailnet:
        host = None
        try:
            me = json.loads(run("tailscale", "status", "--json")).get("Self", {})
            host = (me.get("DNSName") or "").rstrip(".") or next(iter(me.get("TailscaleIPs", [])), None)
        except ValueError:
            pass
        _tailnet.append(host)
    return _tailnet[0]


def live_sessions():
    """Running sessions of hyperbeam projects (those with a manifest), most recently used first. session_last_attached is empty until a session's first
    attach (it updates on every attach and switch-client), so session_created is the fallback."""
    by_sess = {sanitize(n): (n, m) for n, m in load_manifests().items()}
    out, here = [], own_session()
    fmt = "#{session_name}\t#{session_last_attached}\t#{session_created}\t#{session_attached}"
    for line in tmux("list-sessions", "-F", fmt, check=False).stdout.splitlines():
        sess, last, created, attached = line.split("\t")
        if sess not in by_sess:
            continue
        name, man = by_sess[sess]
        out.append(dict(name=name, sess=sess, port=man["port"], here=sess == here,
                        ts=int(last or created or 0), attached=int(attached or 0)))
    return sorted(out, key=lambda s: -s["ts"])


def project_url(port):
    host = tailnet_host()
    return f"http://{host}:{port}" if host and port else None


def print_sessions(sessions, numbered):
    remote = is_remote()
    width = max(len(s["name"]) for s in sessions)
    for i, s in enumerate(sessions, 1):
        port = s["port"]
        cols = [f"{i}" if numbered else "-", s["name"].ljust(width),
                f"{port:<5}", "up  " if port_open(port) else "down", project_url(port) or "(no tailscale)"]
        if not remote:
            cols.append(f"local http://localhost:{port}")
        if s["here"]:
            cols.append("(here)")
        print("  ".join(cols))


def read_choice(n):
    """A number from 1..n, or None for quit. Up to 9 sessions it takes a single keypress."""
    import termios, tty
    while True:
        sys.stdout.write(f"\nNumber to switch to (1-{n}), q to quit: ")
        sys.stdout.flush()
        if n <= 9:
            fd = sys.stdin.fileno()
            old = termios.tcgetattr(fd)
            try:
                tty.setraw(fd)
                ch = sys.stdin.read(1)
            finally:
                termios.tcsetattr(fd, termios.TCSADRAIN, old)
            print(ch if ch.isprintable() else "")
            if ch in ("q", "Q", "\x03", "\x04", "\x1b", ""):
                return None
            if ch.isdigit() and 1 <= int(ch) <= n:
                return int(ch)
        else:
            try:
                line = input().strip()
            except (EOFError, KeyboardInterrupt):
                return None
            if line.lower() == "q":
                return None
            if line.isdigit() and 1 <= int(line) <= n:
                return int(line)


def go_to(session):
    touch_opened(session["name"])
    return attach_here(session["sess"])


def cmd_list(_):
    sessions = live_sessions()
    if not sessions:
        print("No sessions running. Run `hyperbeam` for the menu.")
        return 1
    print_sessions(sessions, numbered=True)
    if not sys.stdin.isatty():
        return 0
    choice = read_choice(len(sessions))
    return 0 if choice is None else go_to(sessions[choice - 1])


def cmd_phone(_):
    sessions = live_sessions()
    if not sessions:
        print("Nothing is running. Try `hyperbeam list` or `hyperbeam` (the menu) to start something.")
        return 1
    print("Open projects (most recent first):")
    print_sessions(sessions, numbered=False)
    target = next((x for x in sessions if not x["here"]), None)
    if target is None:
        print("\nYou are already in the only running session.")
        return 0
    print(f"\nAttaching to {target['name']}...")
    return go_to(target)


# ---------- CLI ----------
def cmd_scan(_):
    mans = load_manifests()
    rows = scan()
    hdr = ["name", "path", "owner", "uncommitted", "manifest"]
    data = [[r["name"], home_rel(r["path"]), r["owner"], "y" if r["dirty"] else "n",
             "y" if r["name"] in mans else "n"] for r in rows]
    w = [max(len(x[i]) for x in data + [hdr]) for i in range(len(hdr))]
    for line in [hdr] + data:
        print("  ".join(c.ljust(w[i]) for i, c in enumerate(line)).rstrip())


def cmd_open(args):
    sess = sanitize(args.name)
    if not session_exists(sess):
        row = next((r for r in scan() if r["name"] == args.name), None)
        man = load_manifests().get(args.name)
        if row is None and man is None:
            sys.exit(f"hyperbeam: no project called {args.name} (try `hyperbeam scan`)")
        start_session(args.name, man, path=row["path"] if row else None)
    touch_opened(args.name)
    if not args.detach:
        sys.exit(attach_here(sess))


def cmd_stop(args):
    man = load_manifests().get(args.name)
    if man is None and not session_exists(sanitize(args.name)):
        sys.exit(f"hyperbeam: {args.name} has no manifest and is not running")
    sys.exit(0 if stop_project(args.name, man) else 1)


def cmd_warn(args):
    p = Path(args.path)
    warns = []
    if not run("git", "-C", str(p), "rev-parse", "--git-dir"):
        warns.append("no git repository")
    else:
        if not run("git", "-C", str(p), "remote"):
            warns.append("no git remote (nothing is backed up)")
        if run("git", "-C", str(p), "status", "--porcelain"):
            warns.append("uncommitted changes")
    if not (p / "CLAUDE.md").exists():
        warns.append("no CLAUDE.md")
    for w in warns:
        print(f"\033[33mhyperbeam: warning: {w}\033[0m")
    if not warns:
        print("hyperbeam: no warnings")
    print(f"PORT={os.environ.get('PORT', '-')}  dir={p}")


# ---------- the menu ----------
TABS = [("running", "Running"), ("recent", "Recent"), ("mine", "Mine"), ("others", "Others"),
        ("unconfigured", "Not configured")]


class Confirm(ModalScreen):
    BINDINGS = [Binding("y,enter", "answer(True)", "Yes"), Binding("n,escape", "answer(False)", "No")]
    DEFAULT_CSS = """
    Confirm { align: center middle; }
    Confirm > Vertical { width: 64; height: auto; border: round $accent; background: $surface; padding: 1 2; }
    Confirm Horizontal { height: 1; margin-top: 1; }
    Confirm Button { height: 1 !important; border: none !important; margin-right: 2; min-width: 10; }
    """

    def __init__(self, text):
        super().__init__()
        self.text = text

    def compose(self) -> ComposeResult:
        with Vertical():
            yield Static(self.text, markup=False)
            with Horizontal():
                yield Button("Yes (y)", id="yes")
                yield Button("No (n)", id="no")

    def on_button_pressed(self, event):
        event.stop()
        self.dismiss(event.button.id == "yes")

    def action_answer(self, value: bool):
        self.dismiss(value)


class Menu(App):
    TITLE = "hyperbeam"
    ENABLE_COMMAND_PALETTE = False
    CSS = """
    #title { height: 1; padding: 0 1; text-style: bold; color: $accent; }
    Tabs { height: 2; }
    #list { height: 1fr; border: round $primary; }
    #detail { height: 3; padding: 0 1; color: $text-muted; }
    #notice { height: 3; padding: 0 1; }
    #buttons { height: 1; margin-top: 1; }
    #buttons Button { height: 1 !important; border: none !important; margin-right: 2; min-width: 12; }
    #keys { width: auto; height: 1; padding: 0 1; color: $text-muted; }
    #hint { height: 1; padding: 0 1; color: $text-muted; }
    """
    BINDINGS = [Binding("o", "open", "Open"), Binding("s", "stop", "Stop"), Binding("b", "onboard", "Onboard"),
                Binding("r", "refresh", "Refresh"), Binding("q", "quit", "Quit"),
                Binding("left", "tab(-1)", "prev tab", show=False), Binding("right", "tab(1)", "next tab", show=False)]

    def __init__(self):
        super().__init__()
        self.projects, self.tab, self.busy = [], "running", set()
        self.first_done = False
        self.keep_notice = False        # True after an action: the refresh then leaves its result message on screen

    def compose(self) -> ComposeResult:
        yield Static("hyperbeam", id="title")
        yield Tabs(*[Tab(label, id=f"t-{key}") for key, label in TABS], id="tabs")
        yield OptionList(id="list")
        yield Static("", id="detail", markup=False)
        yield Static("Loading projects...", id="notice", markup=False)
        with Horizontal(id="buttons"):
            for bid, label in [("open", "Open (o)"), ("stop", "Stop (s)"), ("onboard", "Onboard (b)"),
                               ("refresh", "Refresh (r)"), ("quit", "Quit (q)")]:
                button = Button(label, id=f"b-{bid}")
                button.can_focus = False
                yield button
            yield Static(HINT, id="keys", markup=False)
        yield Static("up/down: select   left/right: tab   Enter or click a row: open   Quit detaches (the menu keeps running)", id="hint")

    def on_mount(self):
        self.query_one("#list", OptionList).focus()
        self.action_refresh()
        self.set_interval(3, self.poll_running)

    # --- data ---
    def action_refresh(self):
        self.reload(keep=False)

    def reload(self, keep):
        self.keep_notice = keep
        if not keep:
            self.say("Scanning projects...")
        self.run_worker(self._load, thread=True, exclusive=True, group="load")

    def _load(self):
        rows = build_projects()
        self.call_from_thread(self.apply, rows)

    def apply(self, rows):
        self.projects = rows
        if not self.first_done:
            self.first_done = True
            for key in ("running", "recent", "mine"):
                self.tab = key
                if self.visible():
                    break
            self.query_one("#tabs", Tabs).active = f"t-{self.tab}"
        self.render_list()
        if not self.keep_notice:
            self.say(f"{len(rows)} projects, {sum(1 for r in rows if r['running'])} running")

    def poll_running(self):
        run_set = running_sessions()
        changed = False
        for p in self.projects:
            now = sanitize(p["name"]) in run_set
            changed |= now != p["running"]
            p["running"] = now
        if changed:
            self.render_list()

    def visible(self):
        P, t = self.projects, self.tab
        if t == "running":
            return [p for p in P if p["running"]]
        if t == "recent":
            return sorted([p for p in P if p["opened"]], key=lambda p: -p["opened"])
        if t == "mine":
            return [p for p in P if p["owner"] == "mine"]
        if t == "others":
            return [p for p in P if p["owner"] != "mine"]
        return [p for p in P if not p["manifest"]]

    def render_list(self):
        ol = self.query_one("#list", OptionList)
        keep = self.current()
        ol.clear_options()
        rows = self.visible()
        for p in rows:
            t = Text()
            t.append("● " if p["running"] else "  ", style="green")
            t.append(f"{p['name']:<26}")
            t.append(f"{p['owner']:<10}", style="dim")
            t.append(f"{p['port'] or '-':>5} ", style="cyan" if p["manifest"] else "dim")
            t.append("* " if p["dirty"] else "  ", style="yellow")
            t.append("configured" if p["manifest"] else "not configured", style="dim")
            if self.tab == "recent":
                t.append(f"  {ago(p['opened'])}", style="dim")
            ol.add_option(Option(t, id=p["name"]))
        if rows:
            names = [p["name"] for p in rows]
            ol.highlighted = names.index(keep["name"]) if keep and keep["name"] in names else 0
            self.call_after_refresh(ol.scroll_to_highlight)
        else:
            ol.add_option(Option(Text("  (nothing here)", style="dim italic"), disabled=True))
        counts = {"running": sum(p["running"] for p in self.projects), "recent": sum(1 for p in self.projects if p["opened"]),
                  "mine": sum(p["owner"] == "mine" for p in self.projects),
                  "others": sum(p["owner"] != "mine" for p in self.projects),
                  "unconfigured": sum(not p["manifest"] for p in self.projects)}
        for key, label in TABS:
            self.query_one(f"#t-{key}", Tab).label = f"{label} ({counts[key]})"
        self.show_detail()

    def current(self):
        ol = self.query_one("#list", OptionList)
        if ol.highlighted is None or ol.highlighted >= ol.option_count:
            return None
        name = ol.get_option_at_index(ol.highlighted).id
        return next((p for p in self.projects if p["name"] == name), None)

    def show_detail(self):
        p = self.current()
        if not p:
            self.query_one("#detail", Static).update("")
            return
        man = load_manifests().get(p["name"])
        svcs = ", ".join(s["name"] for s in man.get("service", [])) if man else ""
        warn = [w for w, bad in [("no git", not p["git"]), ("no remote", p["git"] and not p["remote"]),
                                 ("uncommitted", p["dirty"]), ("no CLAUDE.md", not (p["path"] / "CLAUDE.md").exists())] if bad]
        self.query_one("#detail", Static).update(
            f"{home_rel(p['path'])}   {p['remote'] or ''}\n"
            f"services: {svcs or '-'}   port: {p['port'] or '-'}   url: {project_url(p['port']) or '-'}\nwarnings: {', '.join(warn) or 'none'}")

    def say(self, msg):
        self.query_one("#notice", Static).update(msg)

    def say_from_thread(self, msg):
        self.call_from_thread(self.say, msg)

    # --- events ---
    def on_tabs_tab_activated(self, event):
        if event.tab is not None:
            self.tab = event.tab.id[2:]
            self.render_list()

    def on_option_list_option_highlighted(self, event):
        self.show_detail()

    def on_option_list_option_selected(self, event):
        self.action_open()

    def on_button_pressed(self, event):
        if event.button.id and event.button.id.startswith("b-"):
            getattr(self, "action_" + event.button.id[2:])()

    def action_tab(self, step: int):
        tabs = self.query_one("#tabs", Tabs)
        tabs.action_next_tab() if step > 0 else tabs.action_previous_tab()

    # --- actions ---
    def action_open(self):
        p = self.current()
        if not p:
            return self.say("Nothing selected.")
        if p["name"] in self.busy:
            return self.say(f"{p['name']} is busy.")
        self.busy.add(p["name"])
        self.run_worker(lambda: self._open(p), thread=True)

    def _open(self, p, onboard=False):
        """Open: start the session if needed (no manifest or a failing start lands in Claude with the investigate prompt),
        then switch this client to it. Onboard forces the investigate prompt."""
        name, sess = p["name"], sanitize(p["name"])
        try:
            man = load_manifests().get(name)
            if not session_exists(sess):
                start_session(name, man, self.say_from_thread, path=p["path"], reason="Onboard requested" if onboard else None)
            elif onboard:
                investigate_window(name, p["path"], "Onboard requested; the session was already running")
            touch_opened(name)
            show_session(sess)
            self.say_from_thread(f"{name}: switched ({HINT})")
        except Exception as e:
            self.say_from_thread(f"{name}: ERROR {e}")
        finally:
            self.busy.discard(name)
            self.call_from_thread(self.reload, True)

    def action_stop(self):
        p = self.current()
        if not p:
            return self.say("Nothing selected.")
        man = load_manifests().get(p["name"])
        if not man and not p["running"]:
            return self.say(f"{p['name']} is not running.")
        ports = ", ".join(map(str, project_ports(man))) or "(none: no manifest)"

        def after(yes):
            if yes and p["name"] not in self.busy:
                self.busy.add(p["name"])
                self.run_worker(lambda: self._stop(p), thread=True)
        self.push_screen(Confirm(f"Stop {p['name']}?\n\nRuns its stop commands in reverse order, kills the tmux session, "
                                 f"and checks that port(s) {ports} are free."), after)

    def _stop(self, p):
        try:
            stop_project(p["name"], load_manifests().get(p["name"]), self.say_from_thread)
        except Exception as e:
            self.say_from_thread(f"{p['name']}: ERROR {e}")
        finally:
            self.busy.discard(p["name"])
            self.call_from_thread(self.reload, True)

    def action_onboard(self):
        p = self.current()
        if not p:
            return self.say("Nothing selected.")
        if p["name"] in self.busy:
            return self.say(f"{p['name']} is busy.")
        self.busy.add(p["name"])
        self.run_worker(lambda: self._open(p, onboard=True), thread=True)

    def action_quit(self):
        """Quit detaches the client; the menu keeps running in its tmux session."""
        c = menu_client()
        if c:
            tmux("detach-client", "-t", c, check=False)


def run_menu():
    Menu().run()


def main():
    ap = argparse.ArgumentParser(prog="hyperbeam", description=__doc__)
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("scan", help="list projects").set_defaults(f=cmd_scan)
    o = sub.add_parser("open", help="start a project's session and attach in this terminal")
    o.add_argument("name")
    o.add_argument("-d", "--detach", action="store_true", help="start the session but do not attach")
    o.set_defaults(f=cmd_open)
    s = sub.add_parser("stop", help="run stop commands, kill the session, check the ports")
    s.add_argument("name")
    s.set_defaults(f=cmd_stop)
    sub.add_parser("list", help="numbered list of running sessions with URLs; a number switches to it").set_defaults(f=cmd_list)
    sub.add_parser("phone", help="print the URLs, then attach to the most recently used session").set_defaults(f=cmd_phone)
    sub.add_parser("_menu").set_defaults(f=lambda _: run_menu())
    st = sub.add_parser("_stack")
    st.add_argument("direction", choices=["next", "prev"])
    st.add_argument("client")
    st.add_argument("session")
    st.set_defaults(f=cmd_stack)
    cp = sub.add_parser("_copy-pane")
    cp.add_argument("client_pid")
    cp.add_argument("client")
    cp.add_argument("pane")
    cp.add_argument("session")
    cp.set_defaults(f=cmd_copy_pane)
    cl = sub.add_parser("_clip")
    cl.add_argument("client_pid")
    cl.set_defaults(f=cmd_clip)
    w = sub.add_parser("_warn")
    w.add_argument("path")
    w.set_defaults(f=cmd_warn)
    a = ap.parse_args()
    if a.cmd is None:
        cmd_menu(a)
    else:
        sys.exit(a.f(a) or 0)


if __name__ == "__main__":
    main()
